@model SimplexLawFirm.Models.Invoice

@{
    ViewData["Title"] = $"Invoice #{Model.InvoiceNumber}";
    // Clients are routed to ClientInvoiceDetails by the controller. Keep
    // accountants in the accounts workspace and other staff in their admin view.
    Layout = Context.Session.GetString("UserRole") == nameof(UserRole.Accountant)
        ? "_AccountantLayout"
        : "_AdminLayout";
    
    var paidAmount = ViewBag.PaidAmount as decimal? ?? 0;
    var balanceDue = ViewBag.BalanceDue as decimal? ?? (Model.TotalAmount - paidAmount);
    var isPaid = Model.Status == InvoiceStatus.Paid;
    var isOverdue = Model.DueDate < DateTime.Now && Model.Status != InvoiceStatus.Paid;
}

<div class="container-fluid py-4">
    @if (Model.RequiresEstimateAuthorisation)
    {
        var control = Model.EstimateAuthorisations.OrderByDescending(x => x.RequestedAtUtc).FirstOrDefault();
        <div class="surface refusal mb-4">
            <span class="eyebrow">Invoice blocked</span>
            <h2>Director authorisation required</h2>
            <p>The total varies from locked estimate #@Model.MatterCostEstimateId by @control?.VariancePercent.ToString("+0.0%;-0.0%"). This invoice cannot be sent.</p>
            <a class="btn-primary-modern" href="/Billing/AdminInvoiceDetails/@Model.Id">Review variance control</a>
        </div>
    }
    <div class="row">
        <div class="col-12">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Billing/Invoices">Invoices</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.InvoiceNumber</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <!-- Invoice Main Content -->
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-0">
                                <i class="fas fa-file-invoice text-primary me-2"></i>
                                Invoice @Model.InvoiceNumber
                            </h4>
                            <p class="text-muted mb-0">Issued: @Model.IssueDate.ToString("MMMM dd, yyyy")</p>
                        </div>
                        <div>
                            @if (Model.Status == InvoiceStatus.Draft)
                            {
                                <button type="button" class="btn btn-primary" onclick="sendInvoice(@Model.Id)">
                                    <i class="fas fa-paper-plane"></i> Send to Client
                                </button>
                            }
                            @if (Model.Status != InvoiceStatus.Paid && Model.Status != InvoiceStatus.Draft)
                            {
                                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#paymentModal">
                                    <i class="fas fa-credit-card"></i> Record Payment
                                </button>
                            }
                            <button type="button" class="btn btn-outline-secondary" onclick="window.print();">
                                <i class="fas fa-print"></i> Print
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Status Badge -->
                    <div class="mb-4">
                        @{
                            var statusClass = Model.Status switch
                            {
                                InvoiceStatus.Draft => "bg-secondary",
                                InvoiceStatus.Sent => "bg-info",
                                InvoiceStatus.PartiallyPaid => "bg-warning",
                                InvoiceStatus.Paid => "bg-success",
                                InvoiceStatus.Overdue => "bg-danger",
                                InvoiceStatus.Cancelled => "bg-dark",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @statusClass fs-6 px-3 py-2">
                            <i class="fas fa-circle me-1"></i> @Model.Status
                        </span>
                        
                        @if (isOverdue)
                        {
                            <span class="badge bg-danger fs-6 px-3 py-2 ms-2">
                                <i class="fas fa-exclamation-triangle me-1"></i> OVERDUE
                            </span>
                        }
                    </div>

                    <!-- Client & Case Info -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-muted mb-2">Bill To:</h6>
                            <div class="p-3 bg-light rounded">
                                <p class="mb-1"><strong>@Model.Client?.FullName</strong></p>
                                <p class="mb-1">@Model.Client?.Email</p>
                                <p class="mb-0">@Model.Client?.Phone</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted mb-2">Invoice Details:</h6>
                            <div class="p-3 bg-light rounded">
                                <p class="mb-1"><strong>Invoice Date:</strong> @Model.IssueDate.ToString("MMMM dd, yyyy")</p>
                                <p class="mb-1"><strong>Due Date:</strong> @Model.DueDate.ToString("MMMM dd, yyyy")</p>
                                @if (Model.PaidDate.HasValue)
                                {
                                    <p class="mb-0"><strong>Paid Date:</strong> @Model.PaidDate.Value.ToString("MMMM dd, yyyy")</p>
                                }
                                @if (Model.Case != null)
                                {
                                    <p class="mb-0 mt-2"><strong>Case:</strong> @Model.Case.Title</p>
                                }
                                @if (Model.Retainer != null)
                                {
                                    <p class="mb-0"><strong>Retainer:</strong> @Model.Retainer.Title</p>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Invoice Items Table -->
                    <div class="mb-4">
                        <h6 class="text-muted mb-2">Invoice Items:</h6>
                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>Description</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>@Model.Description</td>
                                        <td class="text-end">R @((Model.Amount-Model.Disbursements.Sum(x=>x.Amount)).ToString("N2"))</td>
                                    </tr>
                                    @foreach (var disbursement in Model.Disbursements)
                                    {
                                        <tr>
                                            <td>Recoverable disbursement — @disbursement.Description</td>
                                            <td class="text-end">R @disbursement.Amount.ToString("N2")</td>
                                        </tr>
                                    }
                                    @if (Model.TaxAmount > 0)
                                    {
                                        <tr>
                                            <td>Tax (VAT)</td>
                                            <td class="text-end">R @Model.TaxAmount.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <th class="text-end">Total:</th>
                                        <th class="text-end">R @Model.TotalAmount.ToString("N2")</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <!-- Payment Summary -->
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <h6 class="text-muted">Total Amount</h6>
                                    <h3 class="text-primary mb-0">R @Model.TotalAmount.ToString("N2")</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <h6 class="text-muted">Amount Paid</h6>
                                    <h3 class="text-success mb-0">R @paidAmount.ToString("N2")</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card @(balanceDue > 0 ? "bg-warning" : "bg-success") bg-opacity-25">
                                <div class="card-body text-center">
                                    <h6 class="text-muted">Balance Due</h6>
                                    <h3 class="@(balanceDue > 0 ? "text-danger" : "text-success") mb-0">R @balanceDue.ToString("N2")</h3>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Notes -->
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="mb-4">
                            <h6 class="text-muted mb-2">Notes:</h6>
                            <div class="p-3 bg-info bg-opacity-10 rounded">
                                @Html.Raw(Model.Notes?.Replace("\n", "<br/>"))
                            </div>
                        </div>
                    }

                    <!-- Payment History -->
                    @if (Model.Payments != null && Model.Payments.Any())
                    {
                        <div class="mb-4">
                            <h6 class="text-muted mb-2">Payment History:</h6>
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Amount</th>
                                            <th>Method</th>
                                            <th>Reference</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var payment in Model.Payments.OrderByDescending(p => p.PaymentDate))
                                        {
                                            <tr>
                                                <td>@payment.PaymentDate.ToString("MMM dd, yyyy")</td>
                                                <td>R @payment.Amount.ToString("N2")</td>
                                                <td>@payment.PaymentMethod</td>
                                                <td>@payment.TransactionReference</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Sidebar Actions -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        @if (Model.Status != InvoiceStatus.Paid && Model.Status != InvoiceStatus.Draft)
                        {
                            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#paymentModal">
                                <i class="fas fa-credit-card"></i> Record Payment
                            </button>
                        }
                        @if (Model.Status == InvoiceStatus.Draft)
                        {
                            <button type="button" class="btn btn-primary" onclick="sendInvoice(@Model.Id)">
                                <i class="fas fa-paper-plane"></i> Send Invoice
                            </button>
                        }
                        @if (Model.PdfPath != null)
                        {
                            <a href="@Model.PdfPath" class="btn btn-danger" target="_blank">
                                <i class="fas fa-file-pdf"></i> Download PDF
                            </a>
                        }
                        <a href="/Billing/Invoices" class="btn btn-outline-secondary">
                            <i class="fas fa-list"></i> All Invoices
                        </a>
                    </div>
                </div>
            </div>

            <!-- Status Timeline -->
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Invoice Timeline</h5>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item">
                            <div class="d-flex">
                                <div class="me-3">
                                    <i class="fas fa-file-invoice fa-2x text-primary"></i>
                                </div>
                                <div>
                                    <strong>Invoice Created</strong>
                                    <p class="text-muted small mb-0">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                                </div>
                            </div>
                        </div>
                        
                        @if (Model.Status != InvoiceStatus.Draft)
                        {
                            <div class="list-group-item">
                                <div class="d-flex">
                                    <div class="me-3">
                                        <i class="fas fa-paper-plane fa-2x text-info"></i>
                                    </div>
                                    <div>
                                        <strong>Invoice Sent</strong>
                                        <p class="text-muted small mb-0">@Model.IssueDate.ToString("MMM dd, yyyy")</p>
                                    </div>
                                </div>
                            </div>
                        }
                        
                        @if (Model.Payments != null && Model.Payments.Any())
                        {
                            <div class="list-group-item">
                                <div class="d-flex">
                                    <div class="me-3">
                                        <i class="fas fa-credit-card fa-2x text-success"></i>
                                    </div>
                                    <div>
                                        <strong>Payment(s) Received</strong>
                                        <p class="text-muted small mb-0">Total: R @Model.Payments.Sum(p => p.Amount).ToString("N2")</p>
                                    </div>
                                </div>
                            </div>
                        }
                        
                        @if (Model.Status == InvoiceStatus.Paid)
                        {
                            <div class="list-group-item bg-success bg-opacity-10">
                                <div class="d-flex">
                                    <div class="me-3">
                                        <i class="fas fa-check-circle fa-2x text-success"></i>
                                    </div>
                                    <div>
                                        <strong>Invoice Paid</strong>
                                        <p class="text-muted small mb-0">@Model.PaidDate?.ToString("MMM dd, yyyy HH:mm")</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Record Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/Billing/MarkAsPaid" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Payment Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">R</span>
                            <input type="number" name="amount" class="form-control" step="0.01" max="@balanceDue" required />
                        </div>
                        <small class="text-muted">Balance due: R @balanceDue.ToString("N2")</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Reference / Transaction ID</label>
                        <input type="text" name="reference" class="form-control" placeholder="e.g., EFT Reference, Card Transaction ID" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Record Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function sendInvoice(id) {
            if (confirm('Send this invoice to the client?')) {
                $.ajax({
                    url: '/Billing/SendInvoice',
                    type: 'POST',
                    data: { id: id },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success || response === '') {
                            alert('Invoice sent successfully!');
                            location.reload();
                        } else {
                            alert('Error sending invoice.');
                        }
                    },
                    error: function() {
                        alert('An error occurred. Please try again.');
                    }
                });
            }
        }
        
        // Auto-hide alerts after 5 seconds
        setTimeout(function() {
            $('.alert').fadeOut(500);
        }, 5000);
    </script>
}

<style>
    @@media print {
        .btn, .modal, .sidebar, .card-header .btn, .card-footer, .no-print {
            display: none !important;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }

        body {
            padding: 0 !important;
            margin: 0 !important;
        }
    }
</style>
