@model SimplexLawFirm.Models.Invoice

@{
    ViewData["Title"] = "Create Invoice";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fas fa-file-invoice fa-2x me-2"></i>
                            <h3 class="d-inline-block mb-0">Create New Invoice</h3>
                        </div>
                        <a href="/Billing/AdminInvoices" class="btn btn-light">
                            <i class="fas fa-arrow-left me-2"></i> Back to Invoices
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <form asp-action="CreateInvoice" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Client & Case Information -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2">
                                    <i class="fas fa-user text-primary"></i> Client Information
                                </h5>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ClientId" class="form-label fw-bold">
                                    Client <span class="text-danger">*</span>
                                </label>
                                <select asp-for="ClientId" class="form-select" asp-items="ViewBag.Clients">
                                    <option value="">-- Select Client --</option>
                                </select>
                                <span asp-validation-for="ClientId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="CaseId" class="form-label fw-bold">Related Case (Optional)</label>
                                <select asp-for="CaseId" class="form-select" asp-items="ViewBag.Cases">
                                    <option value="">-- Select Case --</option>
                                </select>
                                <span asp-validation-for="CaseId" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Invoice Details -->
                        <div class="row mt-4 mb-4">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2">
                                    <i class="fas fa-info-circle text-primary"></i> Invoice Details
                                </h5>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="IssueDate" class="form-label fw-bold">
                                    Issue Date <span class="text-danger">*</span>
                                </label>
                                <input asp-for="IssueDate" class="form-control" type="date" />
                                <span asp-validation-for="IssueDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="DueDate" class="form-label fw-bold">
                                    Due Date <span class="text-danger">*</span>
                                </label>
                                <input asp-for="DueDate" class="form-control" type="date" />
                                <span asp-validation-for="DueDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">
                                Description <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe the services or items being invoiced..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <!-- Amount Details -->
                        <div class="row mt-4 mb-4">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2">
                                    <i class="fas fa-calculator text-primary"></i> Amount Details
                                </h5>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Amount" class="form-label fw-bold">
                                    Subtotal <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">R</span>
                                    <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0" id="subtotal" />
                                </div>
                                <span asp-validation-for="Amount" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="TaxAmount" class="form-label fw-bold">Tax Amount (VAT)</label>
                                <div class="input-group">
                                    <span class="input-group-text">R</span>
                                    <input asp-for="TaxAmount" class="form-control" type="number" step="0.01" min="0" id="taxAmount" />
                                </div>
                                <span asp-validation-for="TaxAmount" class="text-danger"></span>
                                <small class="text-muted">15% VAT is standard</small>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Total Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-primary text-white">R</span>
                                    <input type="text" class="form-control bg-light" id="totalAmount" readonly />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Status" class="form-label fw-bold">Status</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="Draft">Draft</option>
                                    <option value="Sent">Sent</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label fw-bold">Notes (Optional)</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Any additional notes or payment instructions..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                            <small class="text-muted">These notes will appear on the invoice</small>
                        </div>

                        <!-- Action Buttons -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <hr />
                                <div class="d-flex justify-content-between">
                                    <a href="/Billing/AdminInvoices" class="btn btn-secondary">
                                        <i class="fas fa-times"></i> Cancel
                                    </a>
                                    <button type="submit" class="btn btn-primary btn-lg">
                                        <i class="fas fa-save"></i> Create Invoice
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        $(document).ready(function() {
            // Calculate total amount when subtotal or tax changes
            function calculateTotal() {
                var subtotal = parseFloat($('#subtotal').val()) || 0;
                var tax = parseFloat($('#taxAmount').val()) || 0;
                var total = subtotal + tax;
                $('#totalAmount').val('R ' + total.toFixed(2));
            }
            
            $('#subtotal, #taxAmount').on('keyup change', function() {
                calculateTotal();
            });
            
            calculateTotal();
            
            // Apply VAT button
            $('#applyVat').click(function() {
                var subtotal = parseFloat($('#subtotal').val()) || 0;
                var vat = subtotal * 0.15;
                $('#taxAmount').val(vat.toFixed(2));
                calculateTotal();
            });
        });
    </script>
}

<style>
    .form-control:focus, .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
    }
</style>