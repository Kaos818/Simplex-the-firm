@model SimplexLawFirm.Models.Invoice
@{ ViewData["Title"] = "Invoice"; Layout = "_ClientLayout"; var paid = Model.Payments?.Sum(x => x.Amount) ?? 0m; var balance = Math.Max(0, Model.TotalAmount - paid); }
<div class="container-fluid py-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="display-6">Invoice @Model.InvoiceNumber</h1><p class="text-muted mb-0">Issued @Model.IssueDate.ToString("dd MMM yyyy") · Due @Model.DueDate.ToString("dd MMM yyyy")</p></div><span class="badge bg-@(Model.Status == SimplexLawFirm.Models.InvoiceStatus.Paid ? "success" : "warning") fs-6">@Model.Status</span></div><div class="row g-4"><div class="col-lg-8"><section class="card shadow-sm"><div class="card-body"><h2 class="h5">Charges</h2><div class="table-responsive"><table class="table"><tbody><tr><td>@Model.Description</td><td class="text-end">R @Model.Amount.ToString("N2")</td></tr>@foreach(var item in Model.Disbursements ?? []){<tr><td>Disbursement — @item.Description</td><td class="text-end">R @item.Amount.ToString("N2")</td></tr>}@if(Model.TaxAmount > 0){<tr><td>VAT</td><td class="text-end">R @Model.TaxAmount.ToString("N2")</td></tr>}</tbody><tfoot><tr><th>Total</th><th class="text-end">R @Model.TotalAmount.ToString("N2")</th></tr></tfoot></table></div></div></section></div><div class="col-lg-4"><section class="card shadow-sm"><div class="card-body"><h2 class="h5">Balance</h2><p class="mb-1">Paid: <strong>R @paid.ToString("N2")</strong></p><p>Due: <strong class="text-danger">R @balance.ToString("N2")</strong></p>@if(balance > 0){<form method="post" action="/Billing/PayInvoice">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="paymentMethod" value="EFT"/><button class="btn btn-primary w-100">Start payment</button></form>}</div></section></div></div></div>
