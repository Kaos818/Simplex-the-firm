@model List<SimplexLawFirm.Models.Invoice>

@{
    ViewData["Title"] = "Invoices";
    // Accountants manage the firm invoice ledger in the accounts workspace,
    // not through the director navigation.
    Layout = Context.Session.GetString("UserRole") == nameof(UserRole.Accountant)
        ? "_AccountantLayout"
        : "_AdminLayout";
    
    var totalAmount = Model.Sum(i => i.TotalAmount);
    var totalPaid = Model.Where(i => i.Status == InvoiceStatus.Paid).Sum(i => i.TotalAmount);
    var totalOutstanding = totalAmount - totalPaid;
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5 fw-bold">
                        <i class="fas fa-file-invoice text-primary"></i> Invoices
                    </h1>
                    <p class="text-muted">Manage all invoices</p>
                </div>
                <div>
                    <a href="/Billing/CreateInvoice" class="btn btn-primary">
                        <i class="fas fa-plus-circle"></i> Create Invoice
                    </a>
                </div>
            </div>
            <hr />
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h6 class="mb-0">Total Invoices</h6>
                    <h2 class="mb-0">@Model.Count</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h6 class="mb-0">Total Revenue</h6>
                    <h2 class="mb-0">R @totalPaid.ToString("N0")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning text-dark">
                <div class="card-body">
                    <h6 class="mb-0">Outstanding</h6>
                    <h2 class="mb-0">R @totalOutstanding.ToString("N0")</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="">All Status</option>
                        @foreach (InvoiceStatus status in ViewBag.StatusOptions)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Client</label>
                    <select name="clientId" class="form-select" asp-items="ViewBag.Clients">
                        <option value="">All Clients</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search"></i> Filter
                    </button>
                    <a href="/Billing/Invoices" class="btn btn-outline-secondary ms-2">
                        <i class="fas fa-undo"></i> Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Invoices Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Invoice #</th>
                            <th>Client</th>
                            <th>Date</th>
                            <th>Due Date</th>
                            <th>Amount</th>
                            <th>Paid</th>
                            <th>Balance</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in Model)
                        {
                            var paidAmount = invoice.Payments?.Sum(p => p.Amount) ?? 0;
                            var balanceDue = invoice.TotalAmount - paidAmount;
                            
                            <tr>
                                <td>
                                    <strong>@invoice.InvoiceNumber</strong>
                                    @if (invoice.RetainerId.HasValue)
                                    {
                                        <br />
                                        <small class="text-muted">Retainer #@invoice.RetainerId</small>
                                    }
                                </td>
                                <td>
                                    <a href="/Client/Details/@invoice.ClientId">@invoice.Client?.FullName</a>
                                </td>
                                <td>@invoice.IssueDate.ToString("MMM dd, yyyy")</td>
                                <td>@invoice.DueDate.ToString("MMM dd, yyyy")</td>
                                <td class="fw-bold">R @invoice.TotalAmount.ToString("N2")</td>
                                <td class="text-success">R @paidAmount.ToString("N2")</td>
                                <td class="text-danger">R @balanceDue.ToString("N2")</td>
                                <td>
                                    @{
                                        var statusClass = invoice.Status switch
                                        {
                                            InvoiceStatus.Paid => "bg-success",
                                            InvoiceStatus.PartiallyPaid => "bg-warning",
                                            InvoiceStatus.Sent => "bg-info",
                                            InvoiceStatus.Overdue => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @statusClass">@invoice.Status</span>
                                </td>
                                <td>
                                    <a href="/Billing/InvoiceDetails/@invoice.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
