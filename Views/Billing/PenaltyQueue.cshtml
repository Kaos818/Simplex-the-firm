@model List<SimplexLawFirm.Models.Invoice>
@{ ViewData["Title"] = "Penalty Reviews"; Layout = "_AccountantLayout"; }
<div class="container-fluid py-4"><h1 class="mb-1">Penalty Reviews</h1><p class="text-muted">Only pre-agreed penalties may be applied. A factual reason is mandatory and audited.</p>
@if (!Model.Any()) { <div class="alert alert-success"><i class="fas fa-check-circle"></i> No overdue invoices require review.</div> }
@foreach (var invoice in Model) { var paid = invoice.Payments.Sum(x => x.Amount); <div class="card border-0 shadow-sm mb-3"><div class="card-body"><div class="row align-items-center"><div class="col-lg-5"><h5>@invoice.InvoiceNumber</h5><div>@invoice.Client?.FullName</div><small class="text-danger">Due @invoice.DueDate.ToString("dd MMM yyyy") · Outstanding R @((invoice.TotalAmount-paid).ToString("N2"))</small></div><div class="col-lg-7"><form method="post" action="/Billing/ApplyPenalty">@Html.AntiForgeryToken()<input type="hidden" name="invoiceId" value="@invoice.Id" /><label class="form-label fw-semibold">Evidence-based reason</label><div class="input-group"><input class="form-control" name="reason" minlength="10" required placeholder="e.g. Unpaid after due date and agreed grace period" /><button class="btn btn-danger">Apply agreed penalty</button></div></form></div></div></div></div> }
</div>
