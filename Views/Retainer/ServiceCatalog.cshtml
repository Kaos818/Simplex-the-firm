@model List<SimplexLawFirm.Models.RetainerTemplate>

@{
    ViewData["Title"] = "Legal Services";
    Layout = "_ClientLayout";
}

<div class="container py-4">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">Our Legal Services</h1>
        <p class="lead text-muted">Choose the service that best fits your needs. Your dedicated lawyer will review and customize it for you.</p>
    </div>

    @if (ViewBag.Categories != null)
    {
        foreach (var category in ViewBag.Categories)
        {
            <div class="mb-5">
                <h2 class="h3 mb-4 border-bottom pb-2">@category.Key</h2>
                <div class="row g-4">
                    @foreach (var template in category.Value)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm hover-shadow transition">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <h5 class="card-title text-primary fw-bold">@template.Name</h5>
                                        <span class="badge bg-success">@template.Type</span>
                                    </div>
                                    <p class="card-text text-muted small">@template.Description</p>
                                    
                                    <div class="mb-3">
                                        <div class="fw-bold text-success">@template.PriceDisplay</div>
                                        @if (template.IncludedHours > 0)
                                        {
                                            <small class="text-muted">Includes @template.IncludedHours hours</small>
                                        }
                                        @if (template.OverageRate > 0)
                                        {
                                            <small class="text-muted d-block">Overage: R @template.OverageRate.ToString("N2")/hr</small>
                                        }
                                    </div>
                                    
                                    <div class="mb-3">
                                        <span class="badge bg-secondary">@template.BillingCycle</span>
                                        @if (!string.IsNullOrEmpty(template.EstimatedDuration))
                                        {
                                            <span class="badge bg-info ms-1">@template.EstimatedDuration</span>
                                        }
                                    </div>
                                    
                                    <button type="button" class="btn btn-primary w-100" data-bs-toggle="modal" data-bs-target="#detailsModal@(template.Id)">
                                        View Details
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Details Modal -->
                        <div class="modal fade" id="detailsModal@(template.Id)" tabindex="-1">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <div class="modal-header bg-primary text-white">
                                        <h5 class="modal-title">@template.Name</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <h6>Service Description</h6>
                                        <p>@template.Description</p>
                                        
                                        <h6 class="mt-3">What's Included</h6>
                                        <p class="text-muted">@(string.IsNullOrEmpty(template.Inclusions) ? "Details will be discussed with your lawyer" : template.Inclusions)</p>
                                        
                                        @if (!string.IsNullOrEmpty(template.Exclusions))
                                        {
                                            <h6 class="mt-3 text-warning">What's NOT Included</h6>
                                            <p class="text-muted">@template.Exclusions</p>
                                        }
                                        
                                        <div class="row mt-4">
                                            <div class="col-md-6">
                                                <div class="card bg-light">
                                                    <div class="card-body">
                                                        <h6 class="card-title">Pricing</h6>
                                                        <p class="card-text">@template.PriceDisplay</p>
                                                        @if (template.IncludedHours > 0)
                                                        {
                                                            <small>Includes @template.IncludedHours billable hours</small>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="card bg-light">
                                                    <div class="card-body">
                                                        <h6 class="card-title">Terms</h6>
                                                        <p>Billing: @template.BillingCycle</p>
                                                        @if (template.OverageRate > 0)
                                                        {
                                                            <p>Overage Rate: R @template.OverageRate.ToString("N2")/hr</p>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                        <a href="@Url.Action("RequestService", new { id = template.Id })" class="btn btn-primary">Request This Service</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        transition: all 0.3s ease;
    }

    .transition {
        transition: all 0.3s ease;
    }
</style>