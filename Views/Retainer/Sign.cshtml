@model SimplexLawFirm.Models.RetainerSignViewModel

@{
    ViewData["Title"] = "Sign Retainer Agreement";
    Layout = "_ClientLayout";
    var retainer = Model.Retainer;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Header -->
            <div class="text-center mb-4">
                <i class="fas fa-file-signature fa-4x text-primary"></i>
                <h1 class="display-5 fw-bold">Legal Retainer Agreement</h1>
                <p class="text-muted">Please review and sign this agreement to proceed</p>
            </div>

            <!-- Agreement Document -->
            <div class="card shadow-lg border-0 mb-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">@retainer.Title</h4>
                </div>
                <div class="card-body" style="max-height: 600px; overflow-y: auto;">
                    <!-- Parties -->
                    <div class="mb-4">
                        <h5 class="border-bottom pb-2">1. PARTIES</h5>
                        <p>This Retainer Agreement is entered into between:</p>
                        <ul>
                            <li><strong>Client:</strong> @retainer.Client?.FullName</li>
                            <li><strong>Law Firm:</strong> Simplex Law Firm</li>
                        </ul>
                    </div>

                    <!-- Services -->
                    <div class="mb-4">
                        <h5 class="border-bottom pb-2">2. SERVICES</h5>
                        <p><strong>Scope of Work:</strong></p>
                        <div class="p-3 bg-light rounded">
                            @Html.Raw(retainer.ScopeOfWork?.Replace("\n", "<br />"))
                        </div>
                    </div>

                    <!-- Fees -->
                    <div class="mb-4">
                        <h5 class="border-bottom pb-2">3. FEES AND PAYMENT</h5>
                        <table class="table table-sm table-bordered">
                            <tr>
                                <th style="width: 200px">Retainer Type:</th>
                                <td>@retainer.Type</td>
                            </tr>
                            <tr>
                                <th>Total Amount:</th>
                                <td class="fw-bold text-success">R @retainer.Amount.ToString("N2")</td>
                            </tr>
                            <tr>
                                <th>Billing Cycle:</th>
                                <td>@retainer.BillingCycle</td>
                            </tr>
                            @if (retainer.IncludedHours > 0)
                            {
                                <tr>
                                    <th>Included Hours:</th>
                                    <td>@retainer.IncludedHours hours</td>
                                </tr>
                            }
                            @if (retainer.OverageRate > 0)
                            {
                                <tr>
                                    <th>Overage Rate:</th>
                                    <td>R @retainer.OverageRate.ToString("N2")/hour</td>
                                </tr>
                            }
                        </table>
                        @if (Model.RequiresPayment && Model.HasOutstandingInvoice)
                        {
                            <div class="alert alert-warning">
                                <i class="fas fa-credit-card"></i> <strong>Payment Required:</strong> This retainer requires payment of <strong>R @Model.PaymentAmount.ToString("N2")</strong> after signing to activate the service.
                            </div>
                        }
                    </div>

                    <!-- Term -->
                    <div class="mb-4">
                        <h5 class="border-bottom pb-2">4. TERM</h5>
                        <p><strong>Effective Date:</strong> @retainer.StartDate.ToString("dd MMM yyyy")</p>
                        @if (retainer.EndDate.HasValue)
                        {
                            <p><strong>End Date:</strong> @retainer.EndDate.Value.ToString("dd MMM yyyy")</p>
                        }
                        else
                        {
                            <p><strong>End Date:</strong> Ongoing until terminated</p>
                        }
                    </div>

                    <!-- Special Terms -->
                    @if (!string.IsNullOrEmpty(retainer.SpecialTerms))
                    {
                        <div class="mb-4">
                            <h5 class="border-bottom pb-2">5. SPECIAL TERMS & CONDITIONS</h5>
                            <div class="p-3 bg-light rounded">
                                @Html.Raw(retainer.SpecialTerms?.Replace("\n", "<br />"))
                            </div>
                        </div>
                    }

                    <!-- Lawyer Notes -->
                    @if (!string.IsNullOrEmpty(retainer.LawyerNotes))
                    {
                        <div class="mb-4">
                            <h5 class="border-bottom pb-2">6. LAWYER'S NOTES</h5>
                            <div class="p-3 bg-info bg-opacity-10 rounded">
                                @Html.Raw(retainer.LawyerNotes?.Replace("\n", "<br />"))
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Signature Section -->
            <div class="card shadow-lg border-0">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0"><i class="fas fa-signature"></i> Electronic Signature</h4>
                </div>
                <div class="card-body">
                    <form method="post" action="/Retainer/Sign" id="signForm">
                        <input type="hidden" name="id" value="@retainer.Id" />
                        
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> By signing below, you acknowledge that you have read, understood, and agree to be bound by the terms and conditions of this Retainer Agreement.
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="acceptTerms" name="acceptTerms" value="true" required />
                                <label class="form-check-label" for="acceptTerms">
                                    I have read and agree to the terms and conditions of this Retainer Agreement.
                                </label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="signatureName" class="form-label fw-bold">Full Name (Electronic Signature)</label>
                            <input type="text" class="form-control form-control-lg" id="signatureName" name="signatureName" required
                                   placeholder="Type your full legal name as your electronic signature" />
                            <small class="text-muted">This will serve as your legally binding electronic signature.</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Signature Date</label>
                            <input type="text" class="form-control" value="@DateTime.Now.ToString("dd MMM yyyy HH:mm")" disabled />
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#cancelModal">
                                <i class="fas fa-times"></i> Cancel Request
                            </button>
                            <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#requestChangesModal">
                                <i class="fas fa-edit"></i> Request Changes
                            </button>
                            <button type="submit" class="btn btn-success btn-lg" id="signBtn" disabled>
                                <i class="fas fa-signature"></i> Sign Agreement
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cancel Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-times-circle"></i> Cancel Retainer Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/Retainer/CancelRequest">
                <input type="hidden" name="id" value="@retainer.Id" />
                <div class="modal-body">
                    <p>Are you sure you want to cancel this retainer request?</p>
                    <textarea name="cancellationReason" class="form-control" rows="3" placeholder="Please provide a reason for cancellation..." required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Go Back</button>
                    <button type="submit" class="btn btn-danger">Cancel Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Request Changes Modal -->
<div class="modal fade" id="requestChangesModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title"><i class="fas fa-edit"></i> Request Changes</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/Retainer/RequestChanges">
                <input type="hidden" name="id" value="@retainer.Id" />
                <div class="modal-body">
                    <p>Please describe the changes you would like to request:</p>
                    <textarea name="changeRequest" class="form-control" rows="5" required placeholder="Describe the changes you need..."></textarea>
                    <p class="text-muted small mt-2">The law firm will review your request and update the retainer accordingly.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Submit Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#acceptTerms').change(function() {
                $('#signBtn').prop('disabled', !$(this).is(':checked'));
            });

            $('#signatureName').on('input', function() {
                if ($(this).val().trim().length > 0 && $('#acceptTerms').is(':checked')) {
                    $('#signBtn').prop('disabled', false);
                } else {
                    $('#signBtn').prop('disabled', true);
                }
            });
        });
    </script>
}