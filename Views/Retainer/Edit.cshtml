@model SimplexLawFirm.Models.Retainer

@{
    ViewData["Title"] = "Edit Retainer";
    Layout = ViewBag.UserRole == "Admin" ? "_AdminLayout" : "_LawyerLayout";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-warning text-dark">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fas fa-edit fa-2x me-2"></i>
                            <h2 class="d-inline-block mb-0">Edit Retainer</h2>
                            <br />
                            <small>Retainer #@Model.Id | Status: <span class="badge bg-secondary">@Model.Status</span></small>
                        </div>
                        <a href="/Retainer/Index" class="btn btn-dark">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" id="retainerForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedDate" />
                        <input type="hidden" asp-for="Status" />
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        @if (Model.Status == RetainerStatus.Rejected)
                        {
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle"></i>
                                <strong>This retainer was rejected.</strong> Please review the lawyer's notes and make necessary changes.
                                @if (!string.IsNullOrEmpty(Model.LawyerNotes))
                                {
                                    <hr />
                                    <strong>Lawyer's Feedback:</strong>
                                    <p class="mb-0">@Model.LawyerNotes</p>
                                }
                            </div>
                        }

                        <!-- Basic Information -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2">
                                    <i class="fas fa-info-circle text-primary"></i> Basic Information
                                </h5>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Title" class="form-label fw-bold">Retainer Title <span class="text-danger">*</span></label>
                                <input asp-for="Title" class="form-control" />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ClientId" class="form-label fw-bold">Client <span class="text-danger">*</span></label>
                                @{
                                    var isDisabled = Model.Status != RetainerStatus.Draft && Model.Status != RetainerStatus.Rejected;
                                }
                                <select asp-for="ClientId" class="form-select" asp-items="ViewBag.Clients" disabled="@isDisabled">
                                    <option value="">-- Select Client --</option>
                                </select>
                                <span asp-validation-for="ClientId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CaseId" class="form-label fw-bold">Related Case (Optional)</label>
                                <select asp-for="CaseId" class="form-select" asp-items="ViewBag.Cases">
                                    <option value="">-- Select Case --</option>
                                </select>
                                <span asp-validation-for="CaseId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="TemplateId" class="form-label fw-bold">Template Used</label>
                                <select asp-for="TemplateId" class="form-select" asp-items="ViewBag.Templates" disabled>
                                    <option value="">-- None --</option>
                                </select>
                                <span asp-validation-for="TemplateId" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Scope & Terms -->
                        <div class="row mt-4 mb-4">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2">
                                    <i class="fas fa-file-contract text-primary"></i> Scope & Terms
                                </h5>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ScopeOfWork" class="form-label fw-bold">Scope of Work <span class="text-danger">*</span></label>
                            <textarea asp-for="ScopeOfWork" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="ScopeOfWork" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SpecialTerms" class="form-label fw-bold">Special Terms & Conditions</label>
                            <textarea asp-for="SpecialTerms" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="SpecialTerms" class="text-danger"></span>
                        </div>

                        <!-- Fee Structure -->
                        <div class="row mt-4 mb-4">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2">
                                    <i class="fas fa-money-bill-wave text-primary"></i> Fee Structure
                                </h5>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Type" class="form-label fw-bold">Retainer Type <span class="text-danger">*</span></label>
                                <select asp-for="Type" class="form-select" asp-items="ViewBag.RetainerTypes"></select>
                                <span asp-validation-for="Type" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Amount" class="form-label fw-bold">Amount <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">R</span>
                                    <input asp-for="Amount" class="form-control" type="number" step="0.01" />
                                </div>
                                <span asp-validation-for="Amount" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="BillingCycle" class="form-label fw-bold">Billing Cycle</label>
                                <input asp-for="BillingCycle" class="form-control" />
                                <span asp-validation-for="BillingCycle" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="IncludedHours" class="form-label fw-bold">Included Hours</label>
                                <input asp-for="IncludedHours" class="form-control" type="number" step="0.5" />
                                <span asp-validation-for="IncludedHours" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="OverageRate" class="form-label fw-bold">Overage Rate</label>
                                <div class="input-group">
                                    <span class="input-group-text">R</span>
                                    <input asp-for="OverageRate" class="form-control" type="number" step="0.01" />
                                    <span class="input-group-text">/hour</span>
                                </div>
                                <span asp-validation-for="OverageRate" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Dates -->
                        <div class="row mt-4 mb-4">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2">
                                    <i class="fas fa-calendar-alt text-primary"></i> Effective Dates
                                </h5>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartDate" class="form-label fw-bold">Start Date <span class="text-danger">*</span></label>
                                <input asp-for="StartDate" class="form-control" type="date" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="EndDate" class="form-label fw-bold">End Date (Optional)</label>
                                <input asp-for="EndDate" class="form-control" type="date" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Internal Notes -->
                        <div class="row mt-4 mb-4">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2">
                                    <i class="fas fa-sticky-note text-primary"></i> Internal Notes
                                </h5>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AdminNotes" class="form-label fw-bold">Admin Notes</label>
                            <textarea asp-for="AdminNotes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="AdminNotes" class="text-danger"></span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <hr />
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <a href="/Retainer/Index" class="btn btn-secondary">
                                            <i class="fas fa-times"></i> Cancel
                                        </a>
                                        @if (Model.Status == RetainerStatus.Draft || Model.Status == RetainerStatus.Rejected)
                                        {
                                            <button type="button" class="btn btn-danger" onclick="deleteRetainer(@Model.Id)">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        }
                                    </div>
                                    <div>
                                        <button type="submit" class="btn btn-primary btn-lg">
                                            <i class="fas fa-save"></i> Save Changes
                                        </button>
                                        @if (Model.Status == RetainerStatus.Draft || Model.Status == RetainerStatus.Rejected)
                                        {
                                            <button type="button" class="btn btn-success btn-lg" onclick="submitForApproval(@Model.Id)">
                                                <i class="fas fa-paper-plane"></i> Submit for Approval
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle"></i> Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this retainer?</p>
                <p class="text-muted">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentRetainerId = @Model.Id;

        function submitForApproval(id) {
            if (confirm('Are you sure you want to submit this retainer for lawyer approval?')) {
                $.ajax({
                    url: '/Retainer/SubmitForApproval',
                    type: 'POST',
                    data: { id: id },
                    success: function(response) {
                        if (response.success) {
                            showAlert('Retainer submitted for approval!', 'success');
                            setTimeout(() => window.location.href = '/Retainer/Index', 1500);
                        } else {
                            showAlert(response.message || 'Error submitting retainer', 'danger');
                        }
                    },
                    error: function() {
                        showAlert('Error submitting retainer', 'danger');
                    }
                });
            }
        }

        function deleteRetainer(id) {
            currentRetainerId = id;
            $('#deleteModal').modal('show');
        }

        $('#confirmDeleteBtn').click(function() {
            $.ajax({
                url: '/Retainer/Delete/' + currentRetainerId,
                type: 'POST',
                success: function(response) {
                    if (response.success) {
                        $('#deleteModal').modal('hide');
                        showAlert('Retainer deleted successfully!', 'success');
                        setTimeout(() => window.location.href = '/Retainer/Index', 1500);
                    } else {
                        showAlert('Error deleting retainer', 'danger');
                    }
                },
                error: function() {
                    showAlert('Error deleting retainer', 'danger');
                }
            });
        });

        function showAlert(message, type) {
            const icon = type === 'success' ? 'fa-check-circle' : 
                        (type === 'danger' ? 'fa-exclamation-circle' : 'fa-info-circle');
            const alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show position-fixed top-0 end-0 m-3 shadow-lg" style="z-index: 9999; min-width: 300px;" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas ${icon} fa-2x me-3"></i>
                        <div>
                            <strong>${type.charAt(0).toUpperCase() + type.slice(1)}!</strong>
                            <div>${message}</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            $('body').append(alertHtml);
            setTimeout(() => {
                $('.alert').last().fadeOut(500, function() { $(this).remove(); });
            }, 3000);
        }
    </script>
}