@model List<SimplexLawFirm.Models.Retainer>

@{
    ViewData["Title"] = "Retainers Management";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5 fw-bold mb-2">
                        <i class="fas fa-file-signature text-primary"></i> Retainers
                    </h1>
                    <p class="text-muted">Manage legal service agreements and retainer contracts</p>
                </div>
                <div>
                    <a href="/Retainer/Create" class="btn btn-primary btn-lg shadow-sm">
                        <i class="fas fa-plus-circle"></i> New Retainer
                    </a>
                </div>
            </div>
            <hr />
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-2 mb-3">
            <div class="card bg-primary text-white shadow-lg border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Total</h6>
                            <h2 class="mb-0">@Model.Count</h2>
                        </div>
                        <i class="fas fa-file-contract fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 mb-3">
            <div class="card bg-success text-white shadow-lg border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Active</h6>
                            <h2 class="mb-0">@Model.Count(r => r.Status == RetainerStatus.Active)</h2>
                        </div>
                        <i class="fas fa-check-circle fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 mb-3">
            <div class="card bg-warning text-dark shadow-lg border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Pending Approval</h6>
                            <h2 class="mb-0">@Model.Count(r => r.Status == RetainerStatus.PendingApproval)</h2>
                        </div>
                        <i class="fas fa-clock fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 mb-3">
            <div class="card bg-info text-white shadow-lg border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Awaiting Payment</h6>
                            <h2 class="mb-0">@Model.Count(r => r.Status == RetainerStatus.AwaitingPayment)</h2>
                        </div>
                        <i class="fas fa-credit-card fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 mb-3">
            <div class="card bg-secondary text-white shadow-lg border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Draft</h6>
                            <h2 class="mb-0">@Model.Count(r => r.Status == RetainerStatus.Draft)</h2>
                        </div>
                        <i class="fas fa-pen fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 mb-3">
            <div class="card bg-danger text-white shadow-lg border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Rejected</h6>
                            <h2 class="mb-0">@Model.Count(r => r.Status == RetainerStatus.Rejected)</h2>
                        </div>
                        <i class="fas fa-times-circle fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Filter by Status</label>
                            <select class="form-select" id="statusFilter" onchange="filterRetainers()">
                                <option value="">All Statuses</option>
                                <option value="Draft">Draft</option>
                                <option value="PendingApproval">Pending Approval</option>
                                <option value="Approved">Approved</option>
                                <option value="AwaitingPayment">Awaiting Payment</option>
                                <option value="Active">Active</option>
                                <option value="Rejected">Rejected</option>
                                <option value="Cancelled">Cancelled</option>
                                <option value="Completed">Completed</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Search</label>
                            <input type="text" class="form-control" id="searchInput" placeholder="Search by title or client..." onkeyup="filterRetainers()">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Date Range</label>
                            <select class="form-select" id="dateFilter" onchange="filterRetainers()">
                                <option value="">All Time</option>
                                <option value="today">Today</option>
                                <option value="week">This Week</option>
                                <option value="month">This Month</option>
                                <option value="year">This Year</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">&nbsp;</label>
                            <button class="btn btn-outline-secondary w-100" onclick="resetFilters()">
                                <i class="fas fa-undo-alt"></i> Reset Filters
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Retainers Table -->
    <div class="card shadow-lg border-0">
        <div class="card-header bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-list"></i> All Retainers</h5>
                <div>
                    <button class="btn btn-sm btn-outline-secondary" onclick="exportToExcel()">
                        <i class="fas fa-file-excel"></i> Export
                    </button>
                    <button class="btn btn-sm btn-outline-primary" onclick="window.print()">
                        <i class="fas fa-print"></i> Print
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="retainersTable">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Title</th>
                            <th>Client</th>
                            <th>Lawyer</th>
                            <th>Type</th>
                            <th>Amount</th>
                            <th>Created</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="retainersTableBody">
                        @foreach (var retainer in Model.OrderByDescending(r => r.CreatedDate))
                        {
                            <tr data-status="@retainer.Status"
                                data-title="@retainer.Title"
                                data-client="@(retainer.Client?.FirstName ?? "") @(retainer.Client?.LastName ?? "")"
                                data-date="@retainer.CreatedDate.ToString("yyyy-MM-dd")">
                                <td>#@retainer.Id</td>
                                <td>
                                    <strong>@retainer.Title</strong>
                                    <br />
                                    <small class="text-muted">@(retainer.Template?.Name ?? "Custom")</small>
                                </td>
                                <td>@retainer.Client?.FullName</td>
                                <td>@(retainer.AssignedLawyer?.FullName ?? "Unassigned")</td>
                                <td><span class="badge bg-secondary">@retainer.Type</span></td>
                                <td class="fw-bold text-success">R @retainer.Amount.ToString("N2")</td>
                                <td>@retainer.CreatedDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @{
                                        var badgeClass = retainer.Status switch
                                        {
                                            RetainerStatus.Active => "bg-success",
                                            RetainerStatus.Draft => "bg-secondary",
                                            RetainerStatus.PendingApproval => "bg-warning text-dark",
                                            RetainerStatus.Approved => "bg-info",
                                            RetainerStatus.Rejected => "bg-danger",
                                            RetainerStatus.AwaitingPayment => "bg-primary",
                                            RetainerStatus.Cancelled => "bg-dark",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass">@retainer.Status</span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="/Retainer/Details/@retainer.Id" class="btn btn-sm btn-outline-primary" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (retainer.Status == RetainerStatus.Draft || retainer.Status == RetainerStatus.Rejected)
                                        {
                                            <a href="/Retainer/Edit/@retainer.Id" class="btn btn-sm btn-outline-warning" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button onclick="submitForApproval(@retainer.Id)" class="btn btn-sm btn-outline-success" title="Submit for Approval">
                                                <i class="fas fa-paper-plane"></i>
                                            </button>
                                        }
                                        @if (retainer.Status == RetainerStatus.PendingApproval && ViewBag.UserRole == "Lawyer")
                                        {
                                            <a href="/Retainer/Review/@retainer.Id" class="btn btn-sm btn-outline-warning" title="Review">
                                                <i class="fas fa-gavel"></i>
                                            </a>
                                        }
                                        @if (retainer.Status == RetainerStatus.Active)
                                        {
                                            <button onclick="renewRetainer(@retainer.Id)" class="btn btn-sm btn-outline-info" title="Renew">
                                                <i class="fas fa-sync-alt"></i>
                                            </button>
                                        }
                                        <a href="/Retainer/AuditTrail/@retainer.Id" class="btn btn-sm btn-outline-secondary" title="Audit Trail">
                                            <i class="fas fa-history"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Submit for Approval Modal -->
<div class="modal fade" id="submitModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title"><i class="fas fa-paper-plane"></i> Submit for Approval</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to submit this retainer for lawyer approval?</p>
                <div class="mb-3">
                    <label class="form-label">Assign to Lawyer</label>
                    <select id="assignLawyerId" class="form-select">
                        <option value="">-- Select Lawyer --</option>
                        @foreach (var lawyer in ViewBag.Lawyers as SelectList ?? new SelectList(Enumerable.Empty<object>()))
                        {
                            <option value="@lawyer.Value">@lawyer.Text</option>
                        }
                    </select>
                </div>
                <p class="text-muted small">Once submitted, the lawyer will review and approve the retainer before it can be sent to the client.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="confirmSubmitBtn">Submit for Approval</button>
            </div>
        </div>
    </div>
</div>

<!-- Renew Retainer Modal -->
<div class="modal fade" id="renewModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-sync-alt"></i> Renew Retainer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Extend the retainer agreement:</p>
                <div class="mb-3">
                    <label class="form-label">New End Date</label>
                    <input type="date" id="newEndDate" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">New Amount (if different)</label>
                    <input type="number" id="newAmount" class="form-control" step="0.01" placeholder="Leave blank to keep current amount" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-info" id="confirmRenewBtn">Renew Retainer</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentRetainerId = null;

        $(document).ready(function() {
            $('[title]').tooltip();
        });

        function filterRetainers() {
            const status = $('#statusFilter').val();
            const search = $('#searchInput').val().toLowerCase();
            const dateFilter = $('#dateFilter').val();
            const today = new Date();
            
            $('#retainersTableBody tr').each(function() {
                let show = true;
                const row = $(this);
                
                if (status && row.data('status') !== status) {
                    show = false;
                }
                
                if (search && show) {
                    const title = row.data('title').toLowerCase();
                    const client = row.data('client').toLowerCase();
                    if (!title.includes(search) && !client.includes(search)) {
                        show = false;
                    }
                }
                
                if (dateFilter && show) {
                    const rowDate = new Date(row.data('date'));
                    const diffDays = Math.floor((today - rowDate) / (1000 * 60 * 60 * 24));
                    
                    switch(dateFilter) {
                        case 'today':
                            if (diffDays > 0) show = false;
                            break;
                        case 'week':
                            if (diffDays > 7) show = false;
                            break;
                        case 'month':
                            if (diffDays > 30) show = false;
                            break;
                        case 'year':
                            if (diffDays > 365) show = false;
                            break;
                    }
                }
                
                row.toggle(show);
            });
        }

        function resetFilters() {
            $('#statusFilter').val('');
            $('#searchInput').val('');
            $('#dateFilter').val('');
            filterRetainers();
            showAlert('Filters reset successfully', 'info');
        }

        function submitForApproval(id) {
            currentRetainerId = id;
            $('#submitModal').modal('show');
        }

        $('#confirmSubmitBtn').click(function() {
            const lawyerId = $('#assignLawyerId').val();
            
            $.ajax({
                url: '/Retainer/SubmitForApproval',
                type: 'POST',
                data: { id: currentRetainerId, assignedLawyerId: lawyerId },
                success: function(response) {
                    if (response.success) {
                        $('#submitModal').modal('hide');
                        showAlert(response.message, 'success');
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        showAlert(response.message || 'Error submitting retainer', 'danger');
                    }
                },
                error: function() {
                    showAlert('Error submitting retainer', 'danger');
                }
            });
        });

        function renewRetainer(id) {
            currentRetainerId = id;
            $('#renewModal').modal('show');
        }

        $('#confirmRenewBtn').click(function() {
            const newEndDate = $('#newEndDate').val();
            const newAmount = $('#newAmount').val();
            
            if (!newEndDate) {
                showAlert('Please select a new end date', 'danger');
                return;
            }
            
            $.ajax({
                url: '/Retainer/Renew',
                type: 'POST',
                data: { id: currentRetainerId, newEndDate: newEndDate, newAmount: newAmount },
                success: function(response) {
                    if (response.success) {
                        $('#renewModal').modal('hide');
                        showAlert(response.message, 'success');
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        showAlert(response.message || 'Error renewing retainer', 'danger');
                    }
                },
                error: function() {
                    showAlert('Error renewing retainer', 'danger');
                }
            });
        });

        function exportToExcel() {
            const table = document.getElementById('retainersTable');
            const rows = table.querySelectorAll('tr');
            let csv = [];
            
            table.querySelectorAll('thead th').forEach(th => {
                csv.push(th.innerText.trim());
            });
            csv = [csv.join(',')];
            
            $('#retainersTableBody tr:visible').each(function() {
                let row = [];
                $(this).find('td').each(function(index) {
                    if (index < 8) {
                        let text = $(this).text().trim();
                        text = text.replace(/\n/g, ' ').replace(/\s+/g, ' ');
                        row.push(`"${text}"`);
                    }
                });
                csv.push(row.join(','));
            });
            
            const blob = new Blob([csv.join('\n')], { type: 'text/csv' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `retainers_${new Date().toISOString().split('T')[0]}.csv`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            window.URL.revokeObjectURL(url);
            
            showAlert('Export completed successfully!', 'success');
        }

        function showAlert(message, type) {
            const alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show position-fixed top-0 end-0 m-3 shadow-lg" style="z-index: 9999; min-width: 300px;" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas ${type === 'success' ? 'fa-check-circle' : (type === 'danger' ? 'fa-exclamation-circle' : 'fa-info-circle')} fa-2x me-3"></i>
                        <div>
                            <strong>${type.charAt(0).toUpperCase() + type.slice(1)}!</strong>
                            <div>${message}</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            $('body').append(alertHtml);
            setTimeout(() => {
                $('.alert').fadeOut(500, function() { $(this).remove(); });
            }, 3000);
        }
    </script>
}