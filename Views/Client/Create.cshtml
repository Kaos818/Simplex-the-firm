@model CreateClientViewModel
@{
    ViewData["Title"] = "Register Client";
    Layout = Context.Session.GetString("UserRole") == "Lawyer" ? "_LawyerLayout" : "_AdminLayout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fas fa-user-plus fa-2x me-2"></i>
                            <h3 class="d-inline-block mb-0">Register New Client</h3>
                        </div>
                        <a href="@Url.Action("Index")" class="btn btn-light">
                            <i class="fas fa-arrow-left"></i> Back
                        </a>
                    </div>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Client Type Selection -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">Client Type</label>
                            <div class="btn-group w-100" role="group">
                                <input type="radio" class="btn-check" name="IsBusiness" id="individual" value="false" autocomplete="off" checked>
                                <label class="btn btn-outline-primary" for="individual">
                                    <i class="fas fa-user me-2"></i>Individual
                                </label>

                                <input type="radio" class="btn-check" name="IsBusiness" id="business" value="true" autocomplete="off">
                                <label class="btn btn-outline-primary" for="business">
                                    <i class="fas fa-building me-2"></i>Business
                                </label>
                            </div>
                        </div>

                        <!-- Individual Fields -->
                        <div id="individualFields">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="FirstName" class="form-label fw-bold">First Name <span class="text-danger">*</span></label>
                                    <input asp-for="FirstName" class="form-control" />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="LastName" class="form-label fw-bold">Last Name <span class="text-danger">*</span></label>
                                    <input asp-for="LastName" class="form-control" />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label asp-for="SAIDNumber" class="form-label fw-bold">SA ID Number</label>
                                <input asp-for="SAIDNumber" class="form-control" placeholder="e.g., 8001015009088" />
                                <span asp-validation-for="SAIDNumber" class="text-danger"></span>
                                <small class="text-muted">13-digit South African ID number</small>
                            </div>
                        </div>

                        <!-- Business Fields -->
                        <div id="businessFields" style="display: none;">
                            <div class="mb-3">
                                <label asp-for="CompanyName" class="form-label fw-bold">Company Name <span class="text-danger">*</span></label>
                                <input asp-for="CompanyName" class="form-control" />
                                <span asp-validation-for="CompanyName" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="RegistrationNumber" class="form-label fw-bold">Registration Number</label>
                                <input asp-for="RegistrationNumber" class="form-control" placeholder="e.g., 2020/123456/07" />
                                <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Contact Information -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold">Email Address <span class="text-danger">*</span></label>
                                <input asp-for="Email" class="form-control" type="email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-bold">Phone Number <span class="text-danger">*</span></label>
                                <input asp-for="Phone" class="form-control" placeholder="e.g., 0821234567" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Password -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Client Portal Password</label>
                            <input type="password" name="password" class="form-control" placeholder="Leave blank for default: Client123!" />
                            <small class="text-muted">Minimum 8 characters. Client will receive login credentials via email.</small>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-save me-2"></i>Register Client
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            $('input[name="IsBusiness"]').change(function() {
                if ($(this).val() === 'true') {
                    $('#individualFields').hide();
                    $('#businessFields').show();
                    $('#FirstName, #LastName, #SAIDNumber').prop('required', false);
                    $('#CompanyName, #RegistrationNumber').prop('required', true);
                } else {
                    $('#individualFields').show();
                    $('#businessFields').hide();
                    $('#FirstName, #LastName, #SAIDNumber').prop('required', true);
                    $('#CompanyName, #RegistrationNumber').prop('required', false);
                }
            });
        });
    </script>
}
