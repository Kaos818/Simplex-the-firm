@model IEnumerable<SimplexLawFirm.Models.Client>
@{
    ViewData["Title"] = "Client Management";
    Layout = Context.Session.GetString("UserRole") == "Lawyer" ? "_LawyerLayout" : "_AdminLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 mb-0">
                <i class="fas fa-users text-primary me-2"></i>Client Management
            </h1>
            <p class="text-muted">Manage all clients and their information</p>
        </div>
        <a href="@Url.Action("Create")" class="btn btn-primary btn-lg">
            <i class="fas fa-user-plus me-2"></i>New Client
        </a>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card bg-primary text-white shadow-sm stat-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">Total Clients</h6>
                            <h2 class="mb-0">@ViewBag.TotalClients</h2>
                        </div>
                        <i class="fas fa-users fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-info text-white shadow-sm stat-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">Individuals</h6>
                            <h2 class="mb-0">@ViewBag.IndividualCount</h2>
                        </div>
                        <i class="fas fa-user fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-warning text-dark shadow-sm stat-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">Businesses</h6>
                            <h2 class="mb-0">@ViewBag.BusinessCount</h2>
                        </div>
                        <i class="fas fa-building fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-success text-white shadow-sm stat-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">Active</h6>
                            <h2 class="mb-0">@Model.Count(c => c.IsActive)</h2>
                        </div>
                        <i class="fas fa-check-circle fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-5">
                    <label class="form-label">Search</label>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Name, email, phone, company..." value="@ViewBag.SearchTerm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Client Type</label>
                    <select name="isBusiness" class="form-select">
                        <option value="">All Clients</option>
                        <option value="false" selected="@(ViewBag.IsBusiness == false)">Individuals</option>
                        <option value="true" selected="@(ViewBag.IsBusiness == true)">Businesses</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">&nbsp;</label>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-2"></i>Filter
                    </button>
                </div>
                <div class="col-md-2">
                    <label class="form-label">&nbsp;</label>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary w-100">
                        <i class="fas fa-sync-alt me-2"></i>Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Clients Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Client</th>
                            <th>Contact</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Registered</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <i class="fas fa-users fa-3x text-muted mb-3"></i>
                                    <p class="mb-0">No clients found</p>
                                    <a href="@Url.Action("Create")" class="btn btn-sm btn-primary mt-2">Register your first client</a>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var client in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-light rounded-circle me-2 text-center" style="width: 35px;">
                                                <i class="fas @(client.IsBusiness ? "fa-building" : "fa-user") text-primary"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold">@client.FullName</div>
                                                <small class="text-muted">ID: @client.Id</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div><i class="fas fa-envelope me-1 text-muted"></i>@client.Email</div>
                                        <div><i class="fas fa-phone me-1 text-muted"></i>@client.Phone</div>
                                    </td>
                                    <td>
                                        <span class="badge @(client.IsBusiness ? "bg-warning" : "bg-info")">
                                            @(client.IsBusiness ? "Business" : "Individual")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(client.IsActive ? "bg-success" : "bg-secondary")">
                                            @(client.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>@client.CreatedAt.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a href="@Url.Action("Details", new { id = client.Id })" class="btn btn-outline-primary" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="@Url.Action("Edit", new { id = client.Id })" class="btn btn-outline-secondary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger" title="Deactivate" onclick="deactivateClient(@client.Id)">
                                                <i class="fas fa-user-slash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deactivateClient(id) {
            if (confirm('Are you sure you want to deactivate this client?')) {
                $.ajax({
                    url: '/Client/Delete/' + id,
                    type: 'POST',
                    success: function(response) {
                        if (response.success) {
                            showAlert(response.message, 'success');
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            showAlert(response.message, 'danger');
                        }
                    },
                    error: function() {
                        showAlert('An error occurred', 'danger');
                    }
                });
            }
        }
    </script>
}
