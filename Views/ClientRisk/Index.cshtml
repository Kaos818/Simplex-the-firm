@model IReadOnlyList<SimplexLawFirm.Models.ClientRelationshipRisk>
@{Layout=ViewBag.Director?"_AdminLayout":"_LawyerLayout";}
<div class="page-hero compact"><div><span class="eyebrow">Relationship risk</span><h1>Client relationship prediction</h1><p>Transparent rules-based decision support using payment trends, satisfaction signals, and communication delays. It is not an automated decision.</p></div></div>
@if(ViewBag.Director){<form method="post" action="/ClientRisk/Recalculate" class="mb-3">@Html.AntiForgeryToken()<button class="btn-primary-modern">Run relationship-risk analysis</button></form>}
<section class="surface"><table class="table"><thead><tr><th>Client</th><th>Relationship</th><th>Overall</th><th>Why</th><th>Action</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.Client.FullName</td><td>@r.PredictedRelationshipScore.ToString("N0") @(r.HighRiskAlert?"⚠ High":"")</td><td>@r.OverallScore.ToString("N0")</td><td>@r.Explanation</td><td>@if(ViewBag.Director){<form method="post" action="/ClientRisk/RecordAction">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.Id"/><select name="action"><option>Personal check-in</option><option>Fee accommodation</option><option>Reassign attorney</option><option>No action</option></select><input name="notes" required maxlength="2000" placeholder="Decision notes"/><button class="btn btn-sm btn-primary">Record</button></form>}else{@r.DirectorAction}</td></tr>}</tbody></table></section>
