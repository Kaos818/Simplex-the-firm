@model SimplexLawFirm.Models.Beneficiaries.Beneficiary
@using SimplexLawFirm.Models
@using SimplexLawFirm.Models.Beneficiaries
@{ var latest = ViewBag.LatestDocuments as Dictionary<int, BeneficiaryDocument> ?? []; var face = ViewBag.LatestFace as FacialVerificationSession; var audit = ViewBag.Audit as IEnumerable<AuditEntry> ?? []; }
<div class="page-hero compact"><span class="eyebrow">Authorised review</span><h1>@Model.FirstName @Model.LastName</h1><p>Final certification and beneficiary decisions remain with the Director.</p></div>
<div class="row g-4">
<div class="col-lg-7">
<section class="card p-4 mb-4"><h2 class="h4">Application</h2><dl class="row"><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@Model.Status</dd><dt class="col-sm-4">Benefactor</dt><dd class="col-sm-8">@Model.BenefactorClient.FirstName @Model.BenefactorClient.LastName</dd><dt class="col-sm-4">Relationship</dt><dd class="col-sm-8">@Model.RelationshipToBenefactor</dd><dt class="col-sm-4">Review reason</dt><dd class="col-sm-8">@(Model.ManualReviewReason ?? Model.RejectionReason ?? "None recorded")</dd></dl></section>
<section class="card p-4 mb-4"><h2 class="h4">Required documents</h2>
@foreach(var assignment in Model.RequirementAssignments.OrderBy(x=>x.Requirement.DisplayOrder)) {
<div class="border-top py-3"><strong>@assignment.Requirement.DisplayName</strong>
@if(latest.TryGetValue(assignment.RequirementId,out var document)){<p class="mb-1">@document.PreScreenStatus — @(document.UserFacingReason ?? "No user-facing reason recorded.")</p><a asp-action="DownloadDocument" asp-route-documentId="@document.Id">Download through secure access control</a>}
else {<p class="text-danger mb-1">Missing</p>}
<form asp-action="RequestDocument" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 mt-2">@Html.AntiForgeryToken()<input type="hidden" name="requirementId" value="@assignment.RequirementId"/><input name="reason" required maxlength="1000" class="form-control" placeholder="Plain-language reason for a new document"/><button class="btn btn-outline-warning">Request again</button></form></div>}
</section>
<section class="card p-4"><h2 class="h4">Facial and liveness review</h2>
@if(face is null){<p class="text-danger">No facial verification result.</p>}else{<dl class="row"><dt class="col-sm-5">Outcome</dt><dd class="col-sm-7">@face.Status</dd><dt class="col-sm-5">Live actions</dt><dd class="col-sm-7">@(face.LivenessPassed == true ? "Passed" : face.LivenessPassed == false ? "Not passed" : "Requires review")</dd><dt class="col-sm-5">One-to-one match confidence</dt><dd class="col-sm-7">@(face.SimilarityScore?.ToString("P1") ?? "Not available")</dd><dt class="col-sm-5">Reason</dt><dd class="col-sm-7">@(face.ResultReason ?? "None")</dd></dl>}
<form asp-action="RequestFaceCapture" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">@Html.AntiForgeryToken()<input name="reason" required maxlength="1000" class="form-control" placeholder="Reason a new live capture is required"/><button class="btn btn-outline-warning">Request new capture</button></form></section>
</div>
<div class="col-lg-5">
<section class="card p-4 mb-4"><h2 class="h4">Decision</h2>
<form asp-action="Approve" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<textarea name="overrideReason" class="form-control" maxlength="1000" placeholder="Required when overriding a manual facial result"></textarea><button class="btn btn-success mt-2">Approve</button></form>
<form asp-action="Reject" asp-route-id="@Model.Id" method="post" class="mt-3">@Html.AntiForgeryToken()<textarea name="reason" class="form-control" maxlength="1000" required placeholder="User-facing rejection reason"></textarea><button class="btn btn-danger mt-2">Reject</button></form>
<form asp-action="Scrutinize" asp-route-id="@Model.Id" method="post" class="mt-3">@Html.AntiForgeryToken()<textarea name="reason" class="form-control" maxlength="1000" required placeholder="Reason for further scrutiny"></textarea><button class="btn btn-outline-primary mt-2">Place under further scrutiny</button></form></section>
<section class="card p-4"><h2 class="h4">Audit history</h2>@foreach(var item in audit){<div class="border-top py-2"><strong>@item.Action</strong><br/><small>@item.CreatedAtUtc.ToString("u") UTC</small></div>}</section>
</div></div>
