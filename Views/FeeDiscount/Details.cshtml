@model SimplexLawFirm.Models.FeeDiscountRequest
@using SimplexLawFirm.Models
@{var director=Context.Session.GetString("UserRole") is "Director" or "Admin";Layout=director?"_AdminLayout":"_ClientLayout";}<section class="surface"><h1>Fee discount request · @Model.Status</h1><p>Invoice @Model.Invoice.InvoiceNumber · Original R @Model.OriginalAmount.ToString("N2") · Proposed R @Model.ProposedAmount.ToString("N2") (@Model.DiscountPercent.ToString("N1")%)</p><p><b>Eligibility score:</b> @Model.EligibilityScore.ToString("N1") · tier @Model.EligibilityTier · maximum automatic discount @Model.EligibilityLimitSnapshot.ToString("N1")%<br/><b>Recovery check:</b> @Model.ThresholdCheckSnapshot<br/><b>Reliability:</b> @Model.PaymentReliability<br/><b>Recommendation:</b> @Model.Recommendation<br/><b>Reason:</b> @Model.Reason</p>@if(Model.SupportingDocumentPath is not null){<p><a href="@Model.SupportingDocumentPath" target="_blank" rel="noopener">Open supporting document</a></p>}@if(Model.DecisionReason is not null){<p><b>Decision:</b> @Model.DecisionReason</p>}</section>@if(director&&Model.Status==FeeDiscountStatus.PendingDirectorReview){<form method="post" action="/FeeDiscount/Decide" class="surface stack-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><label>Decision<select name="status"><option value="Approve">Approve</option><option value="Reject">Reject</option><option value="CounterOffer">Counter-offer</option></select></label><label>Counter-offer amount (only if applicable)<input name="counterOfferAmount" type="number" step="0.01"/></label><label>Reason<textarea name="reason" required></textarea></label><button class="btn-primary-modern">Record decision</button></form>}@if(!director&&Model.Status==FeeDiscountStatus.CounterOffered){<form method="post" action="/FeeDiscount/CounterOffer" class="surface">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><p>The Director proposed R @Model.CounterOfferAmount?.ToString("N2").</p><button name="accept" value="true" class="btn-primary-modern">Accept counter-offer</button><button name="accept" value="false" class="btn-secondary-modern">Decline counter-offer</button></form>}
