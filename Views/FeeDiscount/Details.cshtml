@model SimplexLawFirm.Models.FeeDiscountRequest
@using SimplexLawFirm.Models
@{var director=Context.Session.GetString("UserRole") is "Director" or "Admin";Layout=director?"_AdminLayout":"_ClientLayout";}<section class="surface"><h1>Fee discount request · @Model.Status</h1><p>Invoice @Model.Invoice.InvoiceNumber · Original R @Model.OriginalAmount.ToString("N2") · Proposed R @Model.ProposedAmount.ToString("N2") (@Model.DiscountPercent.ToString("N1")%)</p><p><b>Reliability:</b> @Model.PaymentReliability<br/><b>Recommendation:</b> @Model.Recommendation<br/><b>Reason:</b> @Model.Reason</p>@if(Model.DecisionReason is not null){<p><b>Decision:</b> @Model.DecisionReason</p>}</section>@if(director&&Model.Status==FeeDiscountStatus.PendingDirector){<form method="post" action="/FeeDiscount/Decide" class="surface stack-form"><input type="hidden" name="id" value="@Model.Id"/><label>Decision<select name="status"><option value="Approved">Approve</option><option value="Rejected">Reject</option><option value="CounterOffered">Counter-offer</option></select></label><label>Counter-offer amount (only if applicable)<input name="counterOfferAmount" type="number" step="0.01"/></label><label>Reason<textarea name="reason" required></textarea></label><button class="btn-primary-modern">Record decision</button></form>}
