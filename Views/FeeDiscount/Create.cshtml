@model SimplexLawFirm.Models.Invoice
@{Layout="_ClientLayout";}<section class="surface stack-form"><h1>Request a fee discount</h1><p>Invoice @Model.InvoiceNumber · R @Model.TotalAmount.ToString("N2")</p><form method="post"><input type="hidden" name="invoiceId" value="@Model.Id"/><label>Proposed payment amount<input name="proposedAmount" type="number" min="0.01" max="@(Model.TotalAmount-.01m)" step="0.01" required/></label><label>Reason<textarea name="reason" required maxlength="2000"></textarea></label><button class="btn-primary-modern">Submit request</button></form></section>
