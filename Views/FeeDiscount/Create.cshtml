@model SimplexLawFirm.Models.Invoice
@{Layout="_ClientLayout";}<section class="surface stack-form"><h1>Request a fee discount</h1><p>Invoice @Model.InvoiceNumber · outstanding R @Model.TotalAmount.ToString("N2")</p><p>Your request is assessed against your payment history and the firm’s 0–30% eligibility tiers. Requests below the matter’s minimum recovery amount are rejected immediately.</p><form method="post" enctype="multipart/form-data"><input type="hidden" name="invoiceId" value="@Model.Id"/><input type="hidden" name="proposedAmount" value="0.01"/><label>Requested discount (%)<input name="requestedDiscountPercent" type="number" min="0.01" max="30" step="0.01" required/></label><label>Reason<textarea name="reason" required maxlength="2000"></textarea></label><label>Supporting document (optional: PDF, JPG, PNG; max 5 MB)<input name="supportingDocument" type="file" accept=".pdf,.jpg,.jpeg,.png"/></label><button class="btn-primary-modern">Submit request</button></form></section>
