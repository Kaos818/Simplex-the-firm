@using SimplexLawFirm.Models
@{ Layout="_LawyerLayout"; var matter=(Case)ViewBag.Case; var documents=(IReadOnlyList<Document>)ViewBag.Documents; }
<div class="page-hero compact"><div><span class="eyebrow">@matter.CaseNumber</span><h1>Prepare disclosure bundle</h1><p>Select matter documents and flag any proposed privileged withholding for Director review.</p></div></div>
@if(!documents.Any()){<div class="alert alert-warning">This matter has no uploaded documents to disclose.</div>}
<form method="post" class="surface stack-form"><input type="hidden" name="caseId" value="@matter.Id"/><label>Opposing attorney name<input name="opposingAttorneyName" maxlength="200" required/></label><label>Opposing attorney email<input name="opposingAttorneyEmail" type="email" maxlength="320" required/></label><h2>Documents</h2>@foreach(var document in documents){<div class="surface"><label><input type="checkbox" name="documentIds" value="@document.Id"/> <b>@document.FileName</b> <small>@document.Category · @document.UploadedAt.ToString("dd MMM yyyy")</small></label><label><input type="checkbox" name="privilegedDocumentIds" value="@document.Id"/> Proposed privileged withholding</label><label>Reason if proposed privileged<textarea name="privilegeReasons[@document.Id]" maxlength="2000" placeholder="e.g. legal advice / litigation privilege"></textarea></label></div>}<button class="btn-primary-modern" disabled="@(!documents.Any())">Create disclosure bundle</button></form>
