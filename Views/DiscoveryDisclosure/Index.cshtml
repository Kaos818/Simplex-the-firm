@model IReadOnlyList<SimplexLawFirm.Models.DiscoveryBundle>
@{ var role=(string)ViewBag.Role; Layout=role=="Lawyer"?"_LawyerLayout":"_AdminLayout"; }
<div class="page-hero compact"><div><span class="eyebrow">Use case 4</span><h1>Discovery &amp; disclosure exchange</h1><p>Privilege review, secure reciprocal exchange and compliance tracking.</p></div></div>
<section class="surface"><table class="table"><thead><tr><th>Matter</th><th>Opposing attorney</th><th>Status</th><th>Sent / received</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Case.CaseNumber</td><td>@item.OpposingAttorneyName<br/><small>@item.OpposingAttorneyEmail</small></td><td>@item.Status</td><td>@(item.ExchangedAtUtc?.ToString("dd MMM yyyy") ?? "Not sent") / @(item.OpposingBundleReceivedAtUtc?.ToString("dd MMM yyyy") ?? "Not received")</td><td><a class="btn-secondary-modern" href="/DiscoveryDisclosure/Details/@item.Id">Open</a></td></tr>}</tbody></table>@if(!Model.Any()){<p>No disclosure bundles are available. Start one from an active matter.</p>}</section>
