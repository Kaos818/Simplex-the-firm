@model SimplexLawFirm.Models.DiscoveryBundle
@using SimplexLawFirm.Models
@{ var role=(string)ViewBag.Role; Layout=role=="Lawyer"?"_LawyerLayout":"_AdminLayout"; }
<div class="page-hero compact"><div><span class="eyebrow">@Model.Status</span><h1>@Model.Case.CaseNumber · disclosure bundle</h1><p>To @Model.OpposingAttorneyName (@Model.OpposingAttorneyEmail)</p></div></div>
<section class="surface"><h2>Bundle record</h2><p><b>Exchange:</b> @(Model.ExchangedAtUtc?.ToString("dd MMM yyyy HH:mm") ?? "Not issued") · link expires @(Model.ExchangeExpiresAtUtc?.ToString("dd MMM yyyy") ?? "—")</p><p><b>Opposing access:</b> @(Model.AccessedAtUtc?.ToString("dd MMM yyyy HH:mm") ?? "Not yet accessed")</p><p><b>Opposing bundle:</b> @(Model.OpposingBundleReceivedAtUtc?.ToString("dd MMM yyyy HH:mm") ?? "Not received")</p>@if(!string.IsNullOrWhiteSpace(Model.ComplianceNotes)){<p><b>Compliance review:</b> @Model.ComplianceNotes</p>}</section>
<section class="surface"><h2>Documents and privilege decisions</h2><table class="table"><thead><tr><th>Document</th><th>Proposed basis</th><th>Decision</th><th>Director record</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.Document.FileName</td><td>@(item.ProposedPrivileged ? item.PrivilegeReason : "Disclose")</td><td>@item.PrivilegeDecision</td><td>@(item.DecidedAtUtc is null ? "Awaiting" : $"{item.DirectorReason} ({item.DecidedAtUtc:dd MMM yyyy})")</td></tr>}</tbody></table></section>
@if(role is "Director" or "Admin"){foreach(var item in Model.Items.Where(x=>x.PrivilegeDecision==PrivilegeDecision.Pending)){<form method="post" action="/DiscoveryDisclosure/DecidePrivilege" class="surface stack-form"><input type="hidden" name="itemId" value="@item.Id"/><h2>Privilege decision: @item.Document.FileName</h2><p>Proposed reason: @item.PrivilegeReason</p><label>Director reasoning<textarea name="reason" maxlength="2000" required></textarea></label><button name="withhold" value="true" class="btn-primary-modern">Approve withholding</button><button name="withhold" value="false" class="btn-secondary-modern">Overrule and disclose</button></form>}}
@if(role=="Lawyer" && Model.Status==DiscoveryBundleStatus.ReadyForExchange){<form method="post" action="/DiscoveryDisclosure/Exchange" class="surface"><input type="hidden" name="id" value="@Model.Id"/><button class="btn-primary-modern">Send secure exchange link</button></form>}
@if(role=="Lawyer" && Model.OpposingDocuments.Any()){<section class="surface"><h2>Received opposing documents</h2><ul>@foreach(var file in Model.OpposingDocuments){<li><a href="/DiscoveryDisclosure/DownloadOpposing/@file.Id">@file.FileName</a> · @(file.SizeBytes / 1024d).ToString("N0") KB</li>}</ul></section><form method="post" action="/DiscoveryDisclosure/CheckCompliance" class="surface stack-form"><input type="hidden" name="id" value="@Model.Id"/><h2>Check opposing disclosure</h2><label>Review outcome<select name="compliant"><option value="true">Complete / compliant</option><option value="false">Gaps identified</option></select></label><label>Review notes or missing documents<textarea name="notes" maxlength="4000" required></textarea></label><button class="btn-primary-modern">Record compliance review</button></form>}
@if(role=="Lawyer" && Model.Status==DiscoveryBundleStatus.GapsIdentified){<form method="post" action="/DiscoveryDisclosure/EscalateGaps" class="surface"><input type="hidden" name="id" value="@Model.Id"/><button class="btn-secondary-modern">Send formal request for missing disclosure</button></form>}
