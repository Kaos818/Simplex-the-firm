@model IReadOnlyList<SimplexLawFirm.Models.CalendarEvent>
@{ ViewData["Title"] = "My Appointments"; Layout = "_ClientLayout"; }
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4"><div><h1>My Appointments</h1><p class="text-muted mb-0">Only appointments linked to your client profile are shown.</p></div><a class="btn btn-primary" href="/ConsultationBooking"><i class="fas fa-calendar-plus"></i> Book consultation</a></div>
    @if (!Model.Any()) { <div class="alert alert-info">No appointments are currently scheduled.</div> }
    else { <div class="row">@foreach (var item in Model) { <div class="col-lg-6 mb-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="d-flex justify-content-between"><h5>@item.Title</h5><span class="badge bg-primary">@item.Status</span></div><p class="mb-1"><i class="fas fa-clock text-primary"></i> @item.StartDateTime.ToString("ddd, dd MMM yyyy HH:mm")</p><p class="mb-1"><i class="fas fa-scale-balanced text-primary"></i> @(item.AssignedToUser?.FullName ?? "Assignment pending")</p><p class="text-muted mb-0">@(item.Case?.Title ?? item.Description)</p></div></div></div> }</div> }
</div>
