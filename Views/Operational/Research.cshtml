@model IReadOnlyList<SimplexLawFirm.Models.LegalAuthority>
@{Layout="_LawyerLayout";ViewData["Title"]="Research case law";}
<div class="page-hero compact"><div><span class="eyebrow">UC-08 · Case execution</span><h1>Research case law</h1><p>Binding authority is ranked first and adverse treatment is shown before reliance.</p></div></div>
<form method="get" class="surface stack-form"><input type="hidden" name="caseId" value="@ViewBag.CaseId"/><div asp-validation-summary="All" class="validation-summary"></div><label>Legal issue or selected passage<textarea name="issue" required>@ViewBag.Issue</textarea></label><button type="submit" class="btn-primary-modern">Research</button></form>
@if(ViewBag.LimitedToInternal == true){<div class="alert alert-warning mt-3"><b>Limited result:</b> external legal sources are unavailable, so these results are from the firm's internal precedent collection only. Verify them against an authoritative source before reliance.</div>}
@if(!string.IsNullOrWhiteSpace(ViewBag.Issue) && !Model.Any()){<div class="surface mt-3"><p class="muted">No matching authority was found in the available source collection. Refine the selected passage or legal issue.</p></div>}
@foreach(var item in Model){<section class="surface mt-3"><span class="status-pill">@item.Rank · @item.Treatment</span><h3>@item.Citation</h3><p>@item.Summary</p><form method="post" action="/Operational/Rely">@Html.AntiForgeryToken()<input type="hidden" name="caseId" value="@ViewBag.CaseId"/><input type="hidden" name="authorityId" value="@item.Id"/><textarea name="reason" required placeholder="Why is this authority relevant?"></textarea>@if(item.Treatment!=SimplexLawFirm.Models.AuthorityTreatment.GoodLaw){<label><input type="checkbox" name="confirmAdverseTreatment" value="true"/> I acknowledge the adverse treatment</label>}<button class="btn-secondary-modern">Attach to matter</button></form></section>}
