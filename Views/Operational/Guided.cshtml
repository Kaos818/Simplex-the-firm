@{Layout="_LawyerLayout";ViewData["Title"]="Guided research";}
<div class="breadcrumb-line"><a href="/Dashboard/Lawyer">Dashboard</a><span>/</span><a href="/Operational/Research?caseId=@ViewBag.CaseId">Research</a><span>/</span><span>Guided</span></div>
<div class="page-hero compact"><div><span class="eyebrow">UC-08 · Case execution</span><h1>Guided research</h1><p>State what you're unsure about and your view. Results come back split — supporting authority and authority you should be ready to distinguish.</p></div><a class="btn-secondary-modern" asp-action="Research" asp-route-caseId="@ViewBag.CaseId">← Back to research</a></div>

<form method="post" class="surface stack-form mt-3"><input type="hidden" name="caseId" value="@ViewBag.CaseId"/>@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation-summary"></div>
 <label>1. What are you unsure about in this matter?<textarea name="unsure" required>@ViewBag.Unsure</textarea></label>
 <label>2. What's your view / position on the issue?<textarea name="view">@ViewBag.View</textarea></label>
 <label>3. What approach are you considering?<textarea name="approach">@ViewBag.Approach</textarea></label>
 <button type="submit" class="btn-primary-modern">Find supporting &amp; opposing authority</button>
</form>

@if(ViewBag.HasResults == true){
 var supports = ViewBag.Supports as IEnumerable<SimplexLawFirm.Models.LegalAuthority>;
 var against = ViewBag.Against as IEnumerable<SimplexLawFirm.Models.LegalAuthority>;
<div class="row g-3 mt-1">
 <div class="col-lg-6">
  <section class="surface" style="border-top:3px solid #3f8f5f;">
   <h3 class="text-success">✅ Supports your position</h3>
   @if(supports == null || !supports.Any()){<p class="muted">No supporting authority found — refine your description.</p>}
   @foreach(var item in supports ?? Enumerable.Empty<SimplexLawFirm.Models.LegalAuthority>()){<div class="record-row align-items-start"><span><b>@item.Citation</b><small>@item.Summary</small></span><a class="btn btn-sm btn-outline-success" asp-action="Authority" asp-route-id="@item.Id" asp-route-caseId="@ViewBag.CaseId">View</a></div>}
  </section>
 </div>
 <div class="col-lg-6">
  <section class="surface" style="border-top:3px solid #b3401e;">
   <h3 class="text-warning">⚠ Against your position</h3>
   @if(against == null || !against.Any()){<p class="muted">No adverse authority found in the available collection.</p>}
   @foreach(var item in against ?? Enumerable.Empty<SimplexLawFirm.Models.LegalAuthority>()){<div class="record-row align-items-start"><span><b>@item.Citation</b><small>@item.Summary — @item.Treatment</small></span><a class="btn btn-sm btn-outline-warning" asp-action="Authority" asp-route-id="@item.Id" asp-route-caseId="@ViewBag.CaseId">View</a></div>}
  </section>
 </div>
</div>
<details class="mt-3"><summary class="muted cursor-pointer">⚠ I disagree with this split — record why</summary>
 <form method="post" action="/Operational/Disagree" class="d-flex gap-2 flex-wrap mt-2">@Html.AntiForgeryToken()<input type="hidden" name="caseId" value="@ViewBag.CaseId"/><input type="hidden" name="topic" value="Guided research split"/><input class="form-control" name="note" placeholder="Why does your professional judgement differ from this split?" required/><button class="btn btn-outline-warning btn-sm">Record disagreement</button></form>
</details>
}
