@{Layout="_LawyerLayout";ViewData["Title"]="Off-site safety";var active=ViewBag.Active as SimplexLawFirm.Models.AttorneyWhereabout;var venues=(IEnumerable<string>)ViewBag.Venues;}
<div class="page-hero compact"><span class="eyebrow">UC-09 · Safety</span><h1>Off-site engagement</h1><p>Check in before leaving and check out when you return. The safety team is alerted automatically if you miss your return time.</p></div>
@if(active is not null){<div class="surface"><span class="eyebrow">Current status</span><h2>Checked in at @active.Venue</h2><p>Expected return: <b>@active.ExpectedReturnAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</b></p><form method="post" action="/Operational/CheckOut">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@active.Id"/><button type="submit" class="btn-primary-modern">Check out safely</button></form></div>}else{<form method="post" class="surface stack-form">@Html.AntiForgeryToken()<label>Recorded court or client location<select name="recordedVenue"><option value="">Select a recorded location</option>@foreach(var venue in venues){<option value="@venue">@venue</option>}</select></label><label>Or specify venue<input name="venue" placeholder="Court, client office or other recorded venue"/></label><label>Expected return<input type="datetime-local" name="expectedReturnUtc" required/></label><button type="submit" class="btn-primary-modern">Check in off-site</button></form>}
