@using SimplexLawFirm.Models
@{
    Layout="_LawyerLayout";ViewData["Title"]="Off-site safety";
    var active=ViewBag.Active as AttorneyWhereabout;
    var venues=(IEnumerable<string>)ViewBag.Venues;
    var timeline=(IReadOnlyList<AttorneyWhereabout>)ViewBag.Timeline;
}
<div class="page-hero compact"><span class="eyebrow">UC-09 · Safety</span><h1>Off-site engagement</h1><p>Check in before leaving and check out when you return. The safety team is alerted automatically if you miss your return time.</p></div>

@if(active is not null){
<div class="surface">
 <span class="eyebrow">Current status</span><h2>You are checked in at @active.Venue</h2>
 <p>Expected return: <b>@active.ExpectedReturnAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</b></p>
 <p class="muted">Check out below when you return. The check-in form comes back once you have checked out.</p>
 @if(active.LocationVerified == true){<div class="alert alert-success">📍 Location verified — @active.DistanceFromVenueMeters?.ToString("N0")m from @active.Venue.</div>}
 else if(active.LocationVerified == false){<div class="alert alert-warning">⚠ Checked in @active.DistanceFromVenueMeters?.ToString("N0")m from @active.Venue. Reason recorded: @active.LocationOverrideReason</div>}
 @if(active.Status == WhereaboutStatus.Emergency){
  <div class="alert alert-danger">🚨 Emergency alert active — Admin and Director have been notified with your location.</div>
 }
 <div class="d-flex gap-2 flex-wrap align-items-center mt-2">
  <form method="post" action="/Operational/CheckOut">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@active.Id"/><button type="submit" class="btn-primary-modern">Check out safely</button></form>
  @if(active.Status != WhereaboutStatus.Emergency){
  <form method="post" action="/Operational/Emergency" onsubmit="return confirm('Send an emergency alert to Admin and Director right now?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@active.Id"/><button type="submit" class="btn" style="background:#c0392b;color:#fff;font-weight:700;">🚨 EMERGENCY</button></form>
  }
 </div>
</div>
}else{
<form method="post" class="surface stack-form" id="checkInForm">@Html.AntiForgeryToken()
 <span class="eyebrow">Check in</span><h2>Check in to an off-site engagement</h2>
 <p class="muted">Record where you are going and when you expect to be back, so the safety team can account for you.</p>
 <div id="gpsNote" class="gps-note muted">📍 Requesting your location…</div>
 <input type="hidden" name="latitude" id="latitudeInput"/>
 <input type="hidden" name="longitude" id="longitudeInput"/>
 <label>Recorded court or client location<select name="recordedVenue"><option value="">Select a recorded location</option>@foreach(var venue in venues){<option value="@venue">@venue</option>}</select></label>
 <label>Or specify venue<input name="venue" placeholder="Court, client office or other recorded venue"/></label>
 <label>Expected return<input type="datetime-local" name="expectedReturnUtc" required/></label>
 <label>Reason if your location doesn't match the venue (fill in if prompted)<input name="locationOverrideReason" placeholder="e.g. Signal only picked up from the car park across the road"/></label>
 <button type="submit" class="btn-primary-modern">Check in off-site</button>
</form>
<script>
(function(){
 var note = document.getElementById('gpsNote');
 if (!navigator.geolocation) { note.textContent = '📍 Location capture is not available on this device — select the venue manually.'; note.className='gps-note muted'; return; }
 navigator.geolocation.getCurrentPosition(function(pos){
  document.getElementById('latitudeInput').value = pos.coords.latitude;
  document.getElementById('longitudeInput').value = pos.coords.longitude;
  note.textContent = '📍 Location captured — this will be checked against the selected venue on submit.';
  note.className='gps-note';
 }, function(){
  note.textContent = '📍 Location unavailable — you can still check in and select the venue manually.';
  note.className='gps-note muted';
 }, { timeout: 8000 });
})();
</script>
<style>.gps-note{padding:8px 12px;border-radius:6px;background:#eef6ff;font-size:.85rem;margin-bottom:10px;}.gps-note.muted{background:#f3f3f3;color:#666;}</style>
}

<section class="surface mt-3">
 <span class="eyebrow">History</span><h2>My whereabouts timeline</h2>
 @if(!timeline.Any()){
  <div class="empty-state">No off-site engagements recorded yet.</div>
 } else {
  @foreach(var item in timeline){
   <div class="record-row">
    <span><b>@item.Venue</b><small>Checked in @item.CheckedInAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")@(item.CheckedOutAtUtc.HasValue ? $" · checked out {item.CheckedOutAtUtc.Value.ToLocalTime():dd MMM yyyy HH:mm}" : "")</small></span>
    <span class="status-pill" style="@(item.Status==WhereaboutStatus.Emergency?"background:#fbe4e4;color:#a11":item.Status is WhereaboutStatus.AlertRaised or WhereaboutStatus.DirectorEscalated?"background:#fff3cd;color:#7a5b00":"")">@item.Status</span>
   </div>
  }
 }
</section>
