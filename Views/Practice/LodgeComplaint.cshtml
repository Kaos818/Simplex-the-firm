@model SimplexLawFirm.ViewModels.LodgeComplaintViewModel
@{ ViewData["Title"] = "Lodge a complaint"; Layout = "_ClientLayout"; var requiresDuplicateConfirmation = ViewBag.RequiresDuplicateConfirmation is true; }
<div class="breadcrumb-line"><a href="/Dashboard/Client">Dashboard</a><span>/</span><span>Service complaints</span></div>
<div class="page-hero compact"><div><span class="eyebrow">Confidential service channel</span><h1>Tell us what happened.</h1><p>Your complaint is referenced, timed, and routed away from anyone it concerns.</p></div></div>
<div class="form-shell"><form method="post" enctype="multipart/form-data" class="surface stack-form">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation-summary"></div><label>Matter<select asp-for="CaseId" required><option value="">Select an active or closed matter</option>@foreach(var c in ViewBag.Cases){<option value="@c.Id">@c.CaseNumber — @c.Title</option>}</select></label><label>Category<select asp-for="Category" asp-items="Html.GetEnumSelectList<SimplexLawFirm.Models.ComplaintCategory>()"></select></label><label>Describe your concern<textarea asp-for="Description" rows="8" placeholder="Include dates, names and what outcome you need."></textarea><span asp-validation-for="Description"></span></label><label>Supporting material <span class="muted">(optional, up to 5 PDF/JPG/PNG files, 10 MB each)</span><input asp-for="Attachments" type="file" multiple accept=".pdf,.jpg,.jpeg,.png"/></label>@if(requiresDuplicateConfirmation){<div class="alert alert-warning"><strong>A similar complaint is already open.</strong> Only continue if this describes a separate incident or concern.</div><label class="check-line"><input asp-for="ConfirmPossibleDuplicate"/> I understand this may duplicate an open complaint and still want to submit it</label>}<div class="privacy-callout"><b>Protected routing</b><span>The matter attorney and anyone named will not receive access to this complaint.</span></div><button type="submit" class="btn-primary-modern">@(requiresDuplicateConfirmation ? "Submit confirmed complaint" : "Lodge complaint securely")</button></form></div>
