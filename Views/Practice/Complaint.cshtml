@model SimplexLawFirm.Models.ServiceComplaint
@using SimplexLawFirm.Models
@{
    ViewData["Title"]="Confidential complaint"; Layout="_AdminLayout";
    var suggestions = Model.Category switch {
        ComplaintCategory.Delay => new[]{ "Issue a written apology acknowledging the delay and its impact on the client.", "Assign a dedicated case manager to provide progress updates.", "Waive disbursement costs incurred as a direct consequence of the delay.", "Expedite outstanding work items with a firm completion date." },
        ComplaintCategory.Billing => new[]{ "Provide a full itemised breakdown of all charges disputed by the client.", "Arrange a billing conference call with the fee earner.", "Offer a fee reduction where charges were not pre-agreed.", "Revise the client care letter to clarify future cost communication." },
        ComplaintCategory.Conduct => new[]{ "Issue a formal written apology from the named fee earner and the firm.", "Initiate an internal disciplinary review under the firm's conduct policy.", "Engage an external mediator to facilitate a structured dialogue.", "Provide written confirmation of corrective action taken." },
        ComplaintCategory.Communication => new[]{ "Establish a regular update schedule with the client in writing.", "Designate a single point of contact with direct contact details.", "Acknowledge all client communications within one working day.", "Review the client care letter to reflect communication commitments." },
        _ => new[]{ "Acknowledge the complaint formally and outline the investigation process.", "Arrange a direct meeting or call between the client and the reviewing Director.", "Provide a written summary of findings within the response window.", "Where appropriate, offer a goodwill gesture proportionate to the inconvenience." }
    };
    var scheduled = Model.Appointments.Where(a => a.Status == ComplaintAppointmentStatus.Scheduled).OrderByDescending(a => a.ScheduledAtUtc).FirstOrDefault();
}
<div class="breadcrumb-line"><a href="/Practice">Practice intelligence</a><span>/</span><span>@Model.ReferenceNumber</span></div>
<div class="page-hero compact"><div><span class="eyebrow">Restricted casework</span><h1>@Model.ReferenceNumber</h1><p>@Model.Category complaint · @Model.Case.CaseNumber</p></div><span class="status-pill large">@Model.Status</span></div>
<div class="workspace-grid">
 <section class="surface"><span class="eyebrow">Client account</span><h2>@Model.Client.FullName</h2><p class="pre-wrap">@Model.Description</p>@if(Model.Attachments.Any()){<h3>Supporting material</h3>@foreach(var file in Model.Attachments){<a class="record-row" href="/Practice/DownloadComplaintAttachment/@file.Id"><span><b>@file.OriginalFileName</b><small>@((file.SizeBytes/1024d).ToString("N0")) KB · integrity verified</small></span><span>Download</span></a>}}</section>
 <section class="surface"><span class="eyebrow">Response clock</span><h2>Due @Model.ResponseDueAtUtc.ToString("dd MMM yyyy, HH:mm") UTC</h2><p>This complaint is withheld from the matter team and all named staff.</p><div class="privacy-callout"><b>Service record protected</b><span>@(((IEnumerable<SimplexLawFirm.Models.StaffServiceRecordEntry>)ViewBag.ServiceRecords).Count()) confidential staff service record(s) updated. The subjects cannot access this complaint.</span></div>@if(Model.Status == ComplaintStatus.Submitted){<form method="post" action="/Practice/AcknowledgeComplaint" class="mt-3">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><button class="btn-primary-modern">Acknowledge complaint</button></form>}</section>

 @if (Model.Status != ComplaintStatus.Resolved) {
 <section class="surface">
  <span class="eyebrow">Resolution</span><h2>Record the outcome</h2>
  <form method="post" action="/Practice/ResolveComplaint" class="stack-form">
   @Html.AntiForgeryToken()<input type="hidden" name="complaintId" value="@Model.Id"/>
   <label>Outcome
    <div class="d-flex gap-2 flex-wrap mt-1">
     <label class="check-line"><input type="radio" name="outcome" value="@ComplaintResolutionOutcome.Upheld" required/> Upheld — the complaint is valid</label>
     <label class="check-line"><input type="radio" name="outcome" value="@ComplaintResolutionOutcome.PartiallyUpheld"/> Partially upheld</label>
     <label class="check-line"><input type="radio" name="outcome" value="@ComplaintResolutionOutcome.NotUpheld"/> Not upheld</label>
    </div>
   </label>
   <label>Mediation steps (select any that apply)
    <details class="mt-1"><summary class="cursor-pointer">💡 Show suggested language for @Model.Category</summary>
     <div class="d-flex flex-column gap-1 mt-2">
      @foreach (var s in suggestions) {<label class="check-line"><input type="checkbox" name="mediationSteps" value="@s"/> @s</label>}
     </div>
    </details>
    <input class="form-control mt-2" name="customStep" placeholder="Add another step…"/>
   </label>
   <label>Formal response to the client (required)<textarea name="formalResponse" rows="5" required placeholder="Dear [Client], thank you for raising this…"></textarea></label>
   <label>Remedy / redress (optional)<textarea name="remedy" rows="2" placeholder="e.g. fee waiver, apology, corrective action…"></textarea></label>
   <button type="submit" class="btn-primary-modern">Record resolution &amp; notify client</button>
  </form>
 </section>
 } else {
 <section class="surface">
  <span class="eyebrow">Resolution recorded</span><h2>@Model.Outcome · resolved by @Model.ResolvedByUser?.FullName</h2>
  <small class="muted">@Model.ResolvedAtUtc?.ToLocalTime().ToString("f")</small>
  <h3 class="mt-3">Mediation steps</h3>
  <ul>@foreach (var s in (Model.MediationSteps ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries)) {<li>@s</li>}</ul>
  @if (!string.IsNullOrWhiteSpace(Model.Remedy)) {<h3>Remedy</h3><p>@Model.Remedy</p>}
  <h3>Formal response</h3><p class="pre-wrap">@Model.FormalResponse</p>
  @if (Model.ClientNotifiedOfResolution) {<p class="text-success">✓ Client notified by email</p>}
 </section>
 }

 <section class="surface">
  <span class="eyebrow">Appointment</span><h2>@(scheduled != null ? "Scheduled" : "Fee / resolution discussion")</h2>
  @if (scheduled != null) {
   <div class="record-row"><span><b>@scheduled.ScheduledAtUtc.ToLocalTime().ToString("f")</b><small>@scheduled.Format@(string.IsNullOrWhiteSpace(scheduled.Notes) ? "" : " · " + scheduled.Notes)</small></span></div>
  }
  <form method="post" action="/Practice/BookComplaintAppointment" class="stack-form mt-2">
   @Html.AntiForgeryToken()<input type="hidden" name="complaintId" value="@Model.Id"/>
   <label>Date &amp; time<input type="datetime-local" name="scheduledAtUtc" required/></label>
   <label>Format
    <select name="format">
     <option value="@AppointmentFormat.Video">Video call</option>
     <option value="@AppointmentFormat.Phone">Phone call</option>
     <option value="@AppointmentFormat.InPerson">In person</option>
    </select>
   </label>
   <label>Notes<input type="text" name="notes" placeholder="What should be discussed?"/></label>
   <button type="submit" class="btn-secondary-modern">@(scheduled != null ? "Reschedule" : "Book appointment")</button>
  </form>
 </section>
</div>
