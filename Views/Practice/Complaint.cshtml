@model SimplexLawFirm.Models.ServiceComplaint
@{ ViewData["Title"]="Confidential complaint"; var isClient=Context.Session.GetString("UserRole")=="Client"; Layout=isClient?"_ClientLayout":"_AdminLayout"; var records=ViewBag.ServiceRecords as IEnumerable<SimplexLawFirm.Models.StaffServiceRecordEntry> ?? []; }
<div class="breadcrumb-line"><a href="@(isClient?"/Practice/MyComplaints":"/Practice")">Complaints</a><span>/</span><span>@Model.ReferenceNumber</span></div>
<div class="page-hero compact"><div><span class="eyebrow">Restricted casework</span><h1>@Model.ReferenceNumber</h1><p>@Model.Category complaint · @Model.Case.CaseNumber</p></div><span class="status-pill large">@Model.Status</span></div>
<div class="workspace-grid"><section class="surface"><span class="eyebrow">Client account</span><h2>@Model.Client.FullName</h2><p style="white-space:pre-wrap">@Model.Description</p>@if(Model.Attachments.Any()){<h3>Supporting material</h3>@foreach(var file in Model.Attachments){<a class="record-row" href="/Practice/DownloadComplaintAttachment/@file.Id"><span><b>@file.OriginalFileName</b><small>@((file.SizeBytes/1024d).ToString("N0")) KB · integrity verified</small></span><span>Download</span></a>}}</section><section class="surface"><span class="eyebrow">Response clock</span><h2>Due @Model.ResponseDueAtUtc.ToString("dd MMM yyyy, HH:mm") UTC</h2><p>This complaint is withheld from the matter team and named staff.</p><div class="privacy-callout"><b>Service record protected</b><span>@records.Count() confidential staff service record(s) updated.</span></div>@if(!isClient && Model.Status == ComplaintStatus.Submitted){<form method="post" action="/Practice/AcknowledgeComplaint" class="mt-3">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><button class="btn-primary-modern">Acknowledge complaint</button></form>}</section></div>
@if(!string.IsNullOrWhiteSpace(Model.DirectorFeedback)){<section class="surface"><span class="eyebrow">Director feedback</span><h2>Response to your complaint</h2><p style="white-space:pre-wrap">@Model.DirectorFeedback</p><small>@Model.RespondedAtUtc?.ToString("dd MMM yyyy HH:mm") UTC</small></section>}
@if(!isClient && Model.Status!=ComplaintStatus.Resolved){<form method="post" action="/Practice/RespondToComplaint" class="surface stack-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><h2>Provide client feedback</h2><label>Response<textarea name="feedback" rows="6" required></textarea></label><div class="d-flex gap-2"><button name="resolve" value="false" class="btn-secondary-modern">Send update</button><button name="resolve" value="true" class="btn-primary-modern">Send and resolve</button></div></form>}
