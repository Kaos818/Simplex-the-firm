@model SimplexLawFirm.ViewModels.ReassignmentViewModel
@{ ViewData["Title"]="Approve reassignment"; Layout="_AdminLayout"; var matter=(SimplexLawFirm.Models.Case)ViewBag.Case; }
<div class="breadcrumb-line"><a href="/Case/Details/@matter.Id">@matter.CaseNumber</a><span>/</span><span>Approve reassignment</span></div>
<div class="page-hero compact"><div><span class="eyebrow">Director approval</span><h1>Transfer @matter.Title</h1><p>The current attorney remains responsible until the receiving attorney accepts a complete handover.</p></div></div>
<div class="form-shell"><form method="post" class="surface stack-form">@Html.AntiForgeryToken()<input asp-for="CaseId" type="hidden"/><div class="responsibility-note">Current responsibility: <b>@matter.Lawyer?.FullName</b></div><label>Receiving attorney<select asp-for="ReceivingAttorneyId" required><option value="">Select an attorney</option>@foreach(var lawyer in ViewBag.Lawyers){<option value="@lawyer.Id">@lawyer.FullName</option>}</select></label><label>Reason for approved reassignment<textarea asp-for="Reason" rows="5" required></textarea></label><button class="btn-primary-modern">Approve & open handover</button></form></div>
