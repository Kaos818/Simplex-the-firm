@using System.Text.Json
@using SimplexLawFirm.ViewModels
@model ForecastPageViewModel
@{ ViewData["Title"]="Outcome forecast"; Layout = Context.Session.GetString("UserRole") == "Lawyer" ? "_LawyerLayout" : "_AdminLayout"; }
<div class="breadcrumb-line"><a href="/Practice">Practice intelligence</a><span>/</span><span>@Model.Case.CaseNumber</span></div>
<div class="page-hero compact"><div><span class="eyebrow">Outcome forecast</span><h1>@Model.Case.Title</h1><p>@Model.Case.CaseType · Evidence profile @Model.Case.EvidenceStrength.ToString("P0")</p></div></div>
@if(Model.Forecast == null){
 <div class="surface action-panel"><div><h2>Ready to assess prospects?</h2><p>The system will use comparable closed matters, firm performance, attorney performance, and the evidence profile. It will refuse rather than guess.</p></div>
 <form method="post" action="/Practice/RequestForecast">@Html.AntiForgeryToken()<input type="hidden" name="caseId" value="@Model.Case.Id"/><button class="btn-primary-modern">Generate forecast</button></form></div>
} else if(Model.Forecast.Status == ForecastStatus.Refused){
 <div class="surface refusal"><span class="eyebrow">Forecast refused</span><h2>No adequate basis</h2><p>@Model.Forecast.RefusalReason</p><small class="d-block mb-3">Refused @Model.Forecast.RequestedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm") and recorded for governance. More comparable matters may exist now — request a fresh assessment to check.</small>
 @if(Context.Session.GetString("UserRole") == "Lawyer"){<form method="post" action="/Practice/RequestForecast">@Html.AntiForgeryToken()<input type="hidden" name="caseId" value="@Model.Case.Id"/><button class="btn-primary-modern">Try again</button></form>}
 </div>
} else {
 var factors=JsonSerializer.Deserialize<List<ForecastFactor>>(Model.Forecast.FactorsJson) ?? [];
 var comparables=JsonSerializer.Deserialize<List<ComparableMatter>>(Model.Forecast.ComparableCasesJson) ?? [];
 <div class="forecast-grid"><div class="probability-card"><span>Estimated success</span><strong>@Model.Forecast.Probability?.ToString("P0")</strong><div>@Model.Forecast.ProbabilityBand</div><small>@Model.Forecast.ConfidenceLevel confidence · @Model.Forecast.ComparableCount comparables</small></div>
 <div class="surface"><span class="eyebrow">Why this result</span>@foreach(var factor in factors){<div class="factor"><div><b>@factor.Label</b><span>@factor.Weight.ToString("P0")</span></div><div class="weight-track"><i style="width:@((int)(factor.Weight*100))%"></i></div><small>@factor.Rationale</small></div>}</div></div>
 <div class="workspace-grid"><section class="surface"><div class="section-heading"><h2>Comparable matters</h2><span class="lock-note">@(Model.Forecast.Status == ForecastStatus.Draft ? "Awaiting attorney assessment" : $"🔒 Snapshot locked {Model.Forecast.LockedAtUtc:dd MMM yyyy HH:mm} UTC")</span></div>
 @foreach(var c in comparables){<a class="record-row" href="/Practice/ForecastEvidence?forecastId=@Model.Forecast.Id&caseId=@c.CaseId"><span><b>@c.CaseNumber</b><small>@c.Title · view supporting documentation →</small></span><span class="status-pill">@c.Outcome</span></a>}</section>
 <section class="surface"><h2>Professional assessment</h2>
 @if(Model.Forecast.Status == ForecastStatus.Draft && Context.Session.GetString("UserRole") == "Lawyer"){<form method="post" action="/Practice/RecordAssessment" class="stack-form">@Html.AntiForgeryToken()<input type="hidden" name="forecastId" value="@Model.Forecast.Id"/><input type="hidden" name="caseId" value="@Model.Case.Id"/><label>Your estimate (%)<input name="attorneyAssessmentPercent" type="number" min="0" max="100" required/></label><label class="check-line"><input name="attorneyAgrees" type="checkbox" value="true"/> I agree with the system forecast</label><label>Reasoning<textarea name="attorneyNotes" rows="4" required></textarea></label><button class="btn-primary-modern">Commit & lock snapshot</button></form>}
 else {<div class="committed"><strong>@Model.Forecast.AttorneyAssessment?.ToString("P0")</strong><p>@(Model.Forecast.AttorneyAgrees == true ? "Agreed with forecast" : "Did not agree with forecast")</p><small>@Model.Forecast.AttorneyNotes</small></div>}</section></div>
 @if(Context.Session.GetString("UserRole") == "Admin" && Model.Forecast.Status == ForecastStatus.Locked){<form method="post" action="/Practice/CloseAndScore" class="surface">@Html.AntiForgeryToken()<input type="hidden" name="caseId" value="@Model.Case.Id"/><span class="eyebrow">Matter closure</span><h2>Record the actual outcome</h2><div class="row g-3"><div class="col-md-4"><label class="form-label">Outcome</label><select class="form-select" name="outcome" asp-items="Html.GetEnumSelectList<ForecastResult>()"></select></div><div class="col-md-8"><label class="form-label">Outcome summary for precedent</label><textarea class="form-control" name="outcomeSummary" rows="3" placeholder="Record the decision, principle and practical result."></textarea></div></div><div class="d-flex gap-4 my-3"><label><input type="checkbox" name="outcomeIsPrivileged" value="true"/> Privileged</label><label><input type="checkbox" name="outcomeIsConfidential" value="true"/> Confidential</label></div><button class="btn-primary-modern">Close, score & curate</button></form>}
 @if(Model.Forecast.Status == ForecastStatus.Scored){<div class="surface action-panel"><div><span class="eyebrow">Calibration result</span><h2>@Model.Forecast.AccuracyScore?.ToString("P0") accuracy</h2><p>Actual outcome: <b>@Model.Forecast.ActualOutcome</b>. This result is included in firm and attorney calibration.</p></div></div>}
}
