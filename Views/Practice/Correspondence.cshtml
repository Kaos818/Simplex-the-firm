@model IEnumerable<SimplexLawFirm.Models.ClientCorrespondence>
@{ ViewData["Title"]="Client correspondence"; var matter=(SimplexLawFirm.Models.Case)ViewBag.Case; var unsigned=(IEnumerable<SimplexLawFirm.Models.Document>)ViewBag.UnsignedDocuments; Layout=Context.Session.GetString("UserRole")=="Lawyer"?"_LawyerLayout":"_AdminLayout"; }
<div class="breadcrumb-line"><a href="/Case/Details/@matter.Id">@matter.CaseNumber</a><span>/</span><span>Client correspondence</span></div>
<div class="page-hero compact"><div><span class="eyebrow">Live matter state</span><h1>Client correspondence</h1><p>Track unanswered client messages so they cannot disappear during a handover.</p></div></div>
<div class="workspace-grid"><section class="surface"><h2>Record incoming correspondence</h2><form method="post" action="/Practice/RecordCorrespondence" class="stack-form">@Html.AntiForgeryToken()<input type="hidden" name="caseId" value="@matter.Id"/><label>Subject<input name="subject" required placeholder="What does the client need answered?"/></label><button class="btn-primary-modern">Record message</button></form></section><section class="surface"><div class="section-heading"><h2>Message register</h2><span class="status-pill">@Model.Count(x=>x.AnsweredAtUtc==null) unanswered</span></div>@foreach(var item in Model){<div class="record-row"><span><b>@item.Subject</b><small>@item.ReceivedAtUtc.ToString("dd MMM yyyy HH:mm") UTC</small></span>@if(item.AnsweredAtUtc==null){<form method="post" action="/Practice/MarkCorrespondenceAnswered">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id"/><button class="btn-primary-modern">Mark answered</button></form>}else{<span class="status-pill">Answered</span>}</div>}@if(!Model.Any()){<div class="empty-state">No client correspondence recorded.</div>}</section></div>
@if(unsigned.Any()){<section class="surface"><div class="section-heading"><div><span class="eyebrow">Signature register</span><h2>Documents awaiting signature</h2></div></div>@foreach(var document in unsigned){<div class="record-row"><span><b>@document.FileName</b><small>Uploaded @document.UploadedAt.ToString("dd MMM yyyy")</small></span><form method="post" action="/Practice/MarkDocumentSigned">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@document.Id"/><input type="hidden" name="caseId" value="@matter.Id"/><button class="btn-primary-modern">Mark signed</button></form></div>}</section>}
