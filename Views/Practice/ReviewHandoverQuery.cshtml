@model SimplexLawFirm.Models.CaseHandover
@using SimplexLawFirm.Models
@{ ViewData["Title"] = "Respond to handover query"; Layout = "_AdminLayout"; }
<div class="director-query-shell">
 <div class="breadcrumb-line"><a href="/Practice/Handovers">Case handovers</a><span>/</span><a href="/Practice/Handover/@Model.Id">@Model.Case.CaseNumber</a><span>/</span><span>Director response</span></div>
 <header class="director-query-hero"><span class="eyebrow">Director action required</span><h1>Respond to the receiving attorney</h1><p>Clarify your reassignment decision so the attorney can make an informed acceptance decision.</p></header>
 <div class="director-query-grid">
  <section class="dq-card"><span class="eyebrow">Question from @Model.ReceivingAttorney.FullName</span><blockquote>@Model.ReceivingAttorneyQuery</blockquote><dl><div><dt>Matter</dt><dd>@Model.Case.CaseNumber · @Model.Case.Title</dd></div><div><dt>Client</dt><dd>@Model.Case.Client?.FullName</dd></div><div><dt>Transfer</dt><dd>@Model.OutgoingAttorney.FullName → @Model.ReceivingAttorney.FullName</dd></div><div><dt>Your original reason</dt><dd>@Model.CaseReassignment.Reason</dd></div>@if (!string.IsNullOrWhiteSpace(Model.UrgentMatters)) { <div><dt>Urgent matters</dt><dd>@Model.UrgentMatters</dd></div> }</dl></section>
  <section class="dq-card response-card"><span class="eyebrow">Recorded response</span><h2>Give clear direction</h2>
   @if (Model.Status == HandoverStatus.QueryRaised) { <form method="post" action="/Practice/RespondToHandoverQuery" class="stack-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><label>Response to the attorney<textarea name="response" rows="9" minlength="20" maxlength="2000" required placeholder="Address the attorney's concern, explain the basis for your decision, and give any risk-management direction."></textarea></label><small>Your response is audited and the attorney will be notified immediately.</small><button type="submit" class="btn-primary-modern">Send response and return for decision</button></form> }
   else { <div class="recorded-response">@Model.DirectorQueryResponse</div><p class="muted">Responded @Model.DirectorQueryRespondedAtUtc?.ToString("dd MMM yyyy HH:mm 'UTC'").</p> }
   <a class="quiet-link" href="/Practice/Handover/@Model.Id">← Open full handover pack</a>
  </section>
 </div>
</div>
<style>.director-query-shell{max-width:1180px;margin:auto;padding:1.5rem}.director-query-hero{max-width:780px;margin:1rem 0 2rem}.director-query-hero h1{font-family:Georgia,serif;font-size:clamp(2rem,4vw,3.2rem);margin:.35rem 0}.director-query-hero p,.muted{color:#667085}.director-query-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:1.25rem}.dq-card{background:#fff;border:1px solid #e6e1d7;border-radius:24px;padding:clamp(1.25rem,3vw,2rem);box-shadow:0 16px 40px rgba(20,35,55,.07)}.dq-card blockquote,.recorded-response{margin:1rem 0;padding:1.2rem;border-left:4px solid #b8892d;background:#fbf8ef;border-radius:10px;font-size:1.08rem;white-space:pre-wrap}.dq-card dl{display:grid;gap:.9rem}.dq-card dl div{border-top:1px solid #ece8df;padding-top:.75rem}.dq-card dt{font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;color:#786b54}.dq-card dd{margin:.2rem 0 0}.response-card h2{font-family:Georgia,serif}.quiet-link{display:inline-block;margin-top:1rem;color:#52606d}@@media(max-width:800px){.director-query-grid{grid-template-columns:1fr}}</style>
