@model SimplexLawFirm.Models.CaseHandoverRequest
@{ Layout="_AdminLayout"; var lawyers=(IEnumerable<SimplexLawFirm.Models.ApplicationUser>)ViewBag.Lawyers; }
<div class="breadcrumb-line"><a href="/Practice/Handovers">Handovers</a><span>/</span><span>Director review</span></div><div class="page-hero compact"><div><span class="eyebrow">Transfer request</span><h1>@Model.Case.CaseNumber · @Model.Case.Title</h1><p>Requested by @Model.RequestedByAttorney.FullName for @Model.Case.Client.FullName</p></div></div>
<div class="workspace-grid"><section class="surface"><h2>Lawyer's reason</h2><p style="white-space:pre-wrap">@Model.Reason</p><a href="/Case/Details/@Model.CaseId" class="btn-secondary-modern">Review complete case record</a></section><form method="post" class="surface stack-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><label>Receiving lawyer<select name="receivingAttorneyId"><option value="">Select lawyer</option>@foreach(var lawyer in lawyers){<option value="@lawyer.Id">@lawyer.FullName</option>}</select></label><label>Director response<textarea name="response" rows="5" required></textarea></label><div class="d-flex gap-2"><button name="approve" value="true" class="btn-primary-modern">Approve and begin handover</button><button name="approve" value="false" class="btn-secondary-modern">Decline request</button></div></form></div>
