@model IReadOnlyList<SimplexLawFirm.Models.CaseHandoverRequest>
@{ Layout="_ClientLayout"; }
<div class="page-hero compact"><div><span class="eyebrow">Case continuity</span><h1>Case handovers</h1><p>See responsibility-transfer decisions affecting your matters. Your full documents and history remain attached to the case.</p></div></div>
<section class="surface">@if(!Model.Any()){<p class="muted">No handovers affect your cases.</p>}@foreach(var item in Model){<div class="record-row"><span><b>@item.Case.CaseNumber · @item.Case.Title</b><small>Requested @item.RequestedAtUtc.ToString("dd MMM yyyy") · @item.DirectorResponse</small></span><span class="status-pill">@item.Status</span></div>}</section>
