@model SimplexLawFirm.ViewModels.RequestProspectsViewModel
@using SimplexLawFirm.Models
@{ ViewData["Title"]="Assessment of prospects"; Layout="_ClientLayout"; var requests=(IEnumerable<ClientForecastRequest>)ViewBag.Requests; }
<div class="breadcrumb-line"><a href="/Dashboard/Client">Dashboard</a><span>/</span><span>Prospects</span></div>
<div class="page-hero compact"><div><span class="eyebrow">Outcome assessment</span><h1>Understand your prospects.</h1><p>Ask the attorney responsible for your matter to prepare a recorded, evidence-based assessment.</p></div></div>
<div class="workspace-grid"><section class="surface"><h2>Request an assessment</h2><form method="post" action="/Practice/RequestProspects" class="stack-form">@Html.AntiForgeryToken()<label>Open matter<select asp-for="CaseId" required><option value="">Select a matter</option>@foreach(var c in ViewBag.Cases){if(c.Status != CaseStatus.Closed){<option value="@c.Id">@c.CaseNumber — @c.Title</option>}}</select></label><label>Question or context <textarea asp-for="Message" rows="4" placeholder="Optional context for your attorney"></textarea></label><button class="btn-primary-modern">Request assessment</button></form></section>
<section class="surface"><div class="section-heading"><div><span class="eyebrow">Request history</span><h2>Your assessments</h2></div></div>@foreach(var item in requests){<div class="record-row"><span><b>@item.Case.CaseNumber</b><small>@item.RequestedAtUtc.ToString("dd MMM yyyy")</small></span><span class="status-pill">@item.Status</span></div>@if(item.FulfilledByForecast != null){<div class="prospects-result"><strong>@(item.FulfilledByForecast.Status == ForecastStatus.Refused ? "No adequate basis" : item.FulfilledByForecast.ProbabilityBand)</strong><span>@(item.FulfilledByForecast.Status == ForecastStatus.Refused ? item.FulfilledByForecast.RefusalReason : $"{item.FulfilledByForecast.ConfidenceLevel} confidence")</span></div>}}@if(!requests.Any()){<div class="empty-state">No assessment requests yet.</div>}</section></div>
