@model SimplexLawFirm.Models.CaseHandover
@using SimplexLawFirm.Models
@{ ViewData["Title"] = "Question handover decision"; Layout = "_LawyerLayout"; }
<div class="query-shell">
 <div class="breadcrumb-line"><a href="/Practice/Handovers">Case handovers</a><span>/</span><a href="/Practice/Handover/@Model.Id">@Model.Case.CaseNumber</a><span>/</span><span>Raise a query</span></div>
 <header class="query-hero"><span class="eyebrow">Receiving attorney review</span><h1>Question the handover decision</h1><p>Ask the Director for clarification before you accept responsibility. Your query and the response become part of the handover audit trail.</p></header>
 <div class="query-grid">
  <section class="query-card context-card"><span class="eyebrow">Director's decision</span><h2>@Model.Case.Title</h2><dl><div><dt>Case</dt><dd>@Model.Case.CaseNumber</dd></div><div><dt>Client</dt><dd>@Model.Case.Client?.FullName</dd></div><div><dt>Transfer</dt><dd>@Model.OutgoingAttorney.FullName → @Model.ReceivingAttorney.FullName</dd></div><div><dt>Director's reason</dt><dd>@Model.CaseReassignment.Reason</dd></div>@if (!string.IsNullOrWhiteSpace(Model.UrgentMatters)) { <div><dt>Urgent matters</dt><dd>@Model.UrgentMatters</dd></div> }</dl></section>
  <section class="query-card">
   @if (Model.Status == HandoverStatus.QueryRaised) { <span class="eyebrow">Awaiting response</span><h2>Your query is with the Director</h2><div class="submitted-query">@Model.ReceivingAttorneyQuery</div><p class="muted">You will receive an in-system notification as soon as the Director responds.</p> }
   else { <span class="eyebrow">Your question</span><h2>What should the Director clarify?</h2><form method="post" action="/Practice/QueryHandover" class="stack-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><label>Question or concern<textarea name="query" rows="8" minlength="20" maxlength="2000" required placeholder="Explain which part of the Director's reassignment decision you question, the risk you identified, and the clarification you need."></textarea></label><small>Be specific and professional. Minimum 20 characters.</small><button class="btn-primary-modern" type="submit">Send query to Director</button></form> }
   <a class="quiet-link" href="/Practice/Handover/@Model.Id">← Return to handover pack</a>
  </section>
 </div>
</div>
<style>.query-shell{max-width:1180px;margin:auto;padding:1.5rem}.query-hero{max-width:760px;margin:1rem 0 2rem}.query-hero h1{font-family:Georgia,serif;font-size:clamp(2rem,4vw,3.2rem);margin:.35rem 0}.query-hero p,.muted{color:#667085}.query-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:1.25rem}.query-card{background:#fff;border:1px solid #e6e1d7;border-radius:24px;padding:clamp(1.25rem,3vw,2rem);box-shadow:0 16px 40px rgba(20,35,55,.07)}.query-card h2{font-family:Georgia,serif}.context-card{background:#fbf8ef}.context-card dl{display:grid;gap:1rem}.context-card dl div{border-top:1px solid #e5dcc8;padding-top:.8rem}.context-card dt{font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;color:#786b54}.context-card dd{margin:.25rem 0 0;font-weight:600}.submitted-query{padding:1rem;border-left:4px solid #b8892d;background:#fbf8ef;border-radius:10px;white-space:pre-wrap}.quiet-link{display:inline-block;margin-top:1rem;color:#52606d}@@media(max-width:800px){.query-grid{grid-template-columns:1fr}}</style>
