@model SimplexLawFirm.Models.Beneficiaries.Beneficiary
@{ ViewData["Title"] = "Edit beneficiary"; }
<div class="page-hero compact"><span class="eyebrow">Beneficiary management</span><h1>Edit draft beneficiary</h1><p>Only draft information can be changed. Verification results and decisions remain protected.</p></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card p-4 stack-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="FirstName"></label><input asp-for="FirstName" class="form-control"/><span asp-validation-for="FirstName" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="LastName"></label><input asp-for="LastName" class="form-control"/><span asp-validation-for="LastName" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="Email"></label><input asp-for="Email" type="email" class="form-control"/></div>
        <div class="col-md-6"><label asp-for="Phone"></label><input asp-for="Phone" class="form-control"/></div>
        <div class="col-md-6"><label asp-for="IdentificationNumber">Identification number</label><input asp-for="IdentificationNumber" class="form-control"/></div>
        <div class="col-md-6"><label asp-for="RelationshipToBenefactor">Relationship</label><input asp-for="RelationshipToBenefactor" class="form-control"/></div>
        <div class="col-12"><label asp-for="EntitlementDescription">Potential entitlement</label><textarea asp-for="EntitlementDescription" class="form-control"></textarea></div>
        <div class="col-md-6"><label asp-for="EntitlementAmountLimit">Maximum cash entitlement</label><input asp-for="EntitlementAmountLimit" type="number" min="0" step="0.01" class="form-control"/></div>
        <div class="col-12"><label asp-for="PermittedAssetPurposes">Permitted purposes</label><textarea asp-for="PermittedAssetPurposes" class="form-control"></textarea></div>
        <div class="col-12"><label asp-for="AssetAccessTerms">Access terms</label><textarea asp-for="AssetAccessTerms" class="form-control" rows="5"></textarea></div>
        <div class="col-md-6"><label asp-for="AccessEligibleFromUtc">Eligible from</label><input asp-for="AccessEligibleFromUtc" type="date" class="form-control"/></div>
        <div class="col-md-6"><label asp-for="AccessEligibleUntilUtc">Eligible until</label><input asp-for="AccessEligibleUntilUtc" type="date" class="form-control"/></div>
    </div>
    <button class="btn-primary-modern mt-3">Save draft</button>
</form>
