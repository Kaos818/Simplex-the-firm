@model SimplexLawFirm.Models.Beneficiaries.Beneficiary
<h1>Bank details for approved asset access</h1><p>Provide the account to receive any authorised cash distribution. Submission does not instruct or guarantee a payment.</p>
<form asp-action="BankDetails" method="post" class="surface stack-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly"></div><label>Account holder<input name="accountHolder" value="@Model.BankAccountHolder" required maxlength="120"/></label><label>Bank<input name="bankName" value="@Model.BankName" required maxlength="100"/></label><label>Account number<input name="accountNumber" value="@Model.BankAccountNumber" required maxlength="40"/></label><label>Branch code<input name="branchCode" value="@Model.BankBranchCode" required maxlength="30"/></label><button class="btn-primary-modern">Submit bank details</button></form>
