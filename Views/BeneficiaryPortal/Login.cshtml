@{ ViewData["Title"] = "Beneficiary portal sign in"; }
<div class="page-hero compact"><span class="eyebrow">Beneficiary portal</span><h1>Sign in to review your access request</h1><p>This portal is limited to your recorded assets, terms, documents, and identity-verification request.</p></div>
<form asp-action="Login" method="post" class="surface stack-form" autocomplete="on">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><label>Email address<input type="email" name="email" autocomplete="username" required/></label><label>Password<input type="password" name="password" autocomplete="current-password" required/></label><button class="btn-primary-modern">Sign in</button></form>
