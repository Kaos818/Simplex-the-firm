@model IEnumerable<SimplexLawFirm.Models.BeneficiaryTrustDisbursementRequest>
@{Layout="_Layout";ViewData["Title"]="Trust requests";}
<div class="page-hero compact"><span class="eyebrow">UC-10 · Trust administration</span><h1>Request your permitted entitlement</h1><p>This portal never displays the benefactor’s total assets or trust balance.</p></div>@if(ViewBag.EntitlementRemaining is decimal remaining&&remaining>0){<div class="metric-card mb-3"><span>Your remaining recorded cash entitlement</span><strong>R @remaining.ToString("N2")</strong></div><form method="post" action="/BeneficiaryPortal/RequestTrustDisbursement" class="surface stack-form">@Html.AntiForgeryToken()<label>Permitted purpose<input name="purpose" required/></label><label>Amount<input name="amount" type="number" min="0.01" max="@remaining" step="0.01" required/></label><label>Reason<textarea name="reason" required></textarea></label><button class="btn-primary-modern">Validate and submit request</button></form>}else{<div class="alert alert-info">No available cash entitlement is currently recorded for you.</div>}@foreach(var item in Model){<div class="record-row"><span><b>@item.ReferenceNumber</b><small>@item.Purpose</small></span><span>R @item.Amount.ToString("N2") · @item.Status</span></div>}
