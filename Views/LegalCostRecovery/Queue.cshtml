@model IReadOnlyList<SimplexLawFirm.Models.LegalCostRecoveryClaim>
@{ Layout = "_AdminLayout"; }
<div class="container-fluid py-4"><div class="d-flex justify-content-between"><div><h1>Cost recovery review queue</h1><p class="text-muted">Director decisions required before service on the opposing party.</p></div><span class="badge bg-warning text-dark align-self-start">@Model.Count pending</span></div><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Case</th><th>Attorney</th><th>Ground</th><th>Claimed</th><th>Submitted</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Case.CaseNumber</td><td>@item.Attorney.FullName</td><td>@item.Ground</td><td>R @item.ClaimedAmount.ToString("N2")</td><td>@item.SubmittedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td><a asp-action="Review" asp-route-id="@item.Id" class="btn btn-dark btn-sm">Review</a></td></tr>}</tbody></table></div></div></div>
