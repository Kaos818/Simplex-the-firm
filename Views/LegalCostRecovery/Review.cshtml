@model SimplexLawFirm.Models.LegalCostRecoveryClaim
@using SimplexLawFirm.Models
@{ Layout = "_AdminLayout"; }
<div class="container-fluid py-4"><h1>Review wasted-cost claim #@Model.Id</h1><p class="text-muted">@Model.Case.CaseNumber - @Model.Attorney.FullName</p><div class="row g-4"><div class="col-lg-7"><div class="card shadow-sm border-0"><div class="card-body"><h5>@Model.Ground</h5><p>@Model.Justification</p><h6>Linked working-hour evidence</h6><table class="table"><thead><tr><th>Date</th><th>Description</th><th>Amount</th></tr></thead><tbody>@foreach(var link in Model.TimeEntries){<tr><td>@link.TimeEntry.Date.ToString("dd MMM yyyy")</td><td>@link.TimeEntry.Description</td><td>R @link.AmountSnapshot.ToString("N2")</td></tr>}</tbody><tfoot><tr><th colspan="2">Claimed</th><th>R @Model.ClaimedAmount.ToString("N2")</th></tr></tfoot></table></div></div></div><div class="col-lg-5"><div class="card shadow-sm border-0"><div class="card-body"><h5>Director decision</h5><form asp-action="Decide" method="post">@Html.AntiForgeryToken()<input name="ClaimId" value="@Model.Id" type="hidden"/><label class="form-label">Decision</label><select id="decision" name="Decision" class="form-select mb-3"><option value="ApprovedInFull">Approve in full</option><option value="PartiallyAwarded">Partially award</option><option value="Rejected">Reject</option></select><div id="partialAward"><label class="form-label">Partial awarded amount</label><input id="awardedAmount" name="AwardedAmount" type="number" min="0.01" max="@Model.ClaimedAmount" step="0.01" class="form-control mb-3"/></div><label class="form-label">Decision notes</label><textarea name="DecisionNotes" required minlength="10" maxlength="4000" rows="5" class="form-control mb-3"></textarea><button class="btn btn-dark w-100">Record final decision</button></form></div></div></div></div></div>
<script>(()=>{const decision=document.getElementById('decision'),area=document.getElementById('partialAward'),amount=document.getElementById('awardedAmount');const update=()=>{const partial=decision.value==='PartiallyAwarded';area.classList.toggle('d-none',!partial);amount.required=partial;if(!partial)amount.value='';};decision.addEventListener('change',update);update();})();</script>
