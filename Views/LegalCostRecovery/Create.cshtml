@model SimplexLawFirm.ViewModels.CreateLegalCostRecoveryViewModel
@using SimplexLawFirm.Models
@{ Layout = "_Layout"; var matter = (Case)ViewBag.Case; var entries = (List<TimeEntry>)ViewBag.TimeEntries; }
<div class="container py-4"><div class="card border-0 shadow-sm"><div class="card-body p-4 p-lg-5">
<span class="badge bg-danger-subtle text-danger mb-3">UC74 - Cost recovery</span><h1>Claim wasted costs</h1><p class="text-muted">@matter.CaseNumber - Select only hours caused by the opposing party's unreasonable conduct.</p>
<form asp-action="Create" method="post">@Html.AntiForgeryToken()<input asp-for="CaseId" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div>
<div class="mb-4"><label asp-for="Ground" class="form-label fw-semibold">Grounds</label><select asp-for="Ground" asp-items="Html.GetEnumSelectList<LegalCostRecoveryGround>()" class="form-select"></select></div>
<div class="mb-4"><label class="form-label fw-semibold">Supporting working hours</label>@if(entries.Count==0){<div class="alert alert-warning">No eligible logged hours remain for this case.</div>}else{<div class="list-group">@foreach(var item in entries){<label class="list-group-item d-flex gap-3"><input class="form-check-input recovery-entry" type="checkbox" name="TimeEntryIds" value="@item.Id" data-amount="@item.TotalAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"/><span><b>@item.Date.ToString("dd MMM yyyy") - @item.Description</b><br/><small>@item.Hours.ToString("0.##") hours x R @item.HourlyRate.ToString("N2") = R @item.TotalAmount.ToString("N2")</small></span></label>}</div><p class="mt-2 mb-0"><strong>Selected claim total: <span id="claimTotal">R 0.00</span></strong></p>}</div>
<div class="mb-4"><label asp-for="Justification" class="form-label fw-semibold">Incident and cost impact</label><textarea asp-for="Justification" class="form-control" rows="6" maxlength="4000"></textarea></div>
<div class="row g-3 mb-4"><div class="col-md-6"><label asp-for="OpposingPartyName" class="form-label fw-semibold">Opposing party</label><input asp-for="OpposingPartyName" class="form-control"/></div><div class="col-md-6"><label asp-for="OpposingPartyEmail" class="form-label fw-semibold">Service email</label><input asp-for="OpposingPartyEmail" class="form-control" type="email"/><small class="text-muted">Nothing is sent until the Director records a decision.</small></div></div>
<button id="submitClaim" class="btn btn-danger" disabled>Submit for director approval</button></form></div></div></div>
@if(entries.Count > 0){<script>(()=>{const entries=[...document.querySelectorAll('.recovery-entry')],button=document.getElementById('submitClaim'),total=document.getElementById('claimTotal');const update=()=>{const amount=entries.filter(x=>x.checked).reduce((sum,x)=>sum+Number(x.dataset.amount),0);total.textContent=`R ${amount.toFixed(2)}`;button.disabled=amount<=0;};entries.forEach(x=>x.addEventListener('change',update));update();})();</script>}
