@model SimplexLawFirm.Models.LegalCostRecoveryClaim
@{ Layout = Model.AttorneyId == Context.Session.GetInt32("UserId") ? "_Layout" : "_AdminLayout"; }
<div class="container py-4"><div class="card shadow-sm border-0"><div class="card-body p-4"><div class="d-flex justify-content-between"><div><h1>Wasted-cost claim #@Model.Id</h1><p>@Model.Case.CaseNumber</p></div><span class="badge bg-dark align-self-start">@Model.Status</span></div><dl class="row"><dt class="col-sm-3">Ground</dt><dd class="col-sm-9">@Model.Ground</dd><dt class="col-sm-3">Claimed</dt><dd class="col-sm-9">R @Model.ClaimedAmount.ToString("N2")</dd><dt class="col-sm-3">Awarded</dt><dd class="col-sm-9">@(Model.AwardedAmount.HasValue ? $"R {Model.AwardedAmount:N2}" : "Pending")</dd><dt class="col-sm-3">Matter recovery total</dt><dd class="col-sm-9">R @Model.Case.CostRecoveryAwardedTotal.ToString("N2")</dd><dt class="col-sm-3">Justification</dt><dd class="col-sm-9">@Model.Justification</dd><dt class="col-sm-3">Decision notes</dt><dd class="col-sm-9">@(Model.DecisionNotes ?? "Pending director review")</dd><dt class="col-sm-3">Service status</dt><dd class="col-sm-9">@(Model.ServedAtUtc.HasValue ? $"Served {Model.ServedAtUtc.Value.ToLocalTime():dd MMM yyyy HH:mm}" : Model.Status == SimplexLawFirm.Models.LegalCostRecoveryStatus.Rejected ? "Not served - claim rejected" : "Not served - awaiting director decision")</dd></dl><h5>Linked working-hour evidence</h5><table class="table"><thead><tr><th>Date</th><th>Description</th><th>Hours</th><th>Amount</th></tr></thead><tbody>@foreach(var link in Model.TimeEntries.OrderBy(x=>x.TimeEntry.Date)){<tr><td>@link.TimeEntry.Date.ToString("dd MMM yyyy")</td><td>@link.TimeEntry.Description</td><td>@link.TimeEntry.Hours.ToString("0.##")</td><td>R @link.AmountSnapshot.ToString("N2")</td></tr>}</tbody></table><h5>Audit trail</h5><ul class="list-group">@foreach(var audit in Model.AuditEntries.OrderBy(x=>x.RecordedAtUtc)){<li class="list-group-item"><b>@audit.Action</b> - @audit.RecordedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")<br/><small>@audit.Details</small></li>}</ul></div></div></div>
