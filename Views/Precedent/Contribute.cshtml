@model SimplexLawFirm.Models.KnowledgeArticle
@{ Layout="_LawyerLayout"; var subjects=(IEnumerable<SimplexLawFirm.Models.LegalSubject>)ViewBag.Subjects; }
<div class="page-hero compact"><div><span class="eyebrow">Firm knowledge</span><h1>Contribute to the legal library</h1><p>Add reusable, non-privileged legal analysis that can strengthen future case and cost comparisons.</p></div></div>
<form method="post" class="surface stack-form">@Html.AntiForgeryToken()<label>Title<input asp-for="Title" required/></label><label>Legal subject<select asp-for="SuggestedSubjectId"><option value="">Allow classification</option>@foreach(var subject in subjects){<option value="@subject.Id">@subject.Name</option>}</select></label><label>Legal analysis<textarea asp-for="Content" rows="14" minlength="100" required placeholder="Summarise the legal principle, procedural lesson, source and practical application. Do not include client-identifying or privileged content."></textarea></label><div class="privacy-callout"><b>Eligibility screening</b><span>Contributions are checked for privilege, confidentiality, duplication and subject coverage before becoming current precedent.</span></div><button class="btn-primary-modern">Submit to library</button></form>
