@model SimplexLawFirm.Models.SettlementRecommendation
@{ ViewData["Title"] = "Settlement recommendation"; var role = Context.Session.GetString("UserRole"); }
<div class="page-hero compact"><div><span class="eyebrow">Use case 06</span><h1>@Model.Case?.CaseNumber settlement analysis</h1><p>@Model.Status · generated @Model.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p></div></div>
<section class="surface"><h2>@(Model.SettlementRecommended ? "Settlement recommended" : "Litigation remains preferred")</h2><p>@Model.Rationale</p><dl class="row"><dt class="col-sm-4">Matter value</dt><dd class="col-sm-8">R @Model.MatterValueSnapshot.ToString("N2")</dd><dt class="col-sm-4">Expected litigation value</dt><dd class="col-sm-8">R @Model.ExpectedLitigationValue.ToString("N2")</dd><dt class="col-sm-4">Expected settlement value</dt><dd class="col-sm-8">R @Model.ExpectedSettlementValue.ToString("N2")</dd><dt class="col-sm-4">Suggested range</dt><dd class="col-sm-8">R @Model.SuggestedSettlementLow?.ToString("N2") – R @Model.SuggestedSettlementHigh?.ToString("N2")</dd></dl><p><b>Attorney:</b> @Model.Attorney?.FullName · @Model.AttorneyResponse</p><p><b>Director:</b> @Model.Director?.FullName · @Model.DirectorResponse</p></section>
@if(role=="Lawyer" && Model.Status==SettlementRecommendationStatus.PendingAttorneyReview){<form method="post" action="/SettlementDashboard/AttorneyDecision" class="surface stack-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><h2>Attorney decision</h2><label>Reasoning<textarea name="reasoning" maxlength="2000" required></textarea></label><button name="action" value="Accept" class="btn-primary-modern">Accept and begin settlement</button><button name="action" value="Reject" class="btn-secondary-modern">Reject recommendation</button><button name="action" value="Escalate" class="btn-secondary-modern">Escalate to Director</button></form>}
@if(role is "Director" or "Admin" && Model.Status==SettlementRecommendationStatus.EscalatedToDirector){<form method="post" action="/SettlementDashboard/DirectorDecision" class="surface stack-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><h2>Director decision</h2><label>Reasoning<textarea name="reasoning" maxlength="2000" required></textarea></label><button name="approve" value="true" class="btn-primary-modern">Approve settlement</button><button name="approve" value="false" class="btn-secondary-modern">Reject settlement</button></form>}
