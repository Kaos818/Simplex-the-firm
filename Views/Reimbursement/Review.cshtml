@model SimplexLawFirm.Models.ReimbursementClaim
@{ ViewData["Title"]="Review "+Model.ClaimNumber; Layout="_AdminLayout"; }
<div class="breadcrumb-line"><a href="/Reimbursement/DirectorQueue">Reimbursement approvals</a><span>/</span><span>@Model.ClaimNumber</span></div>
<div class="page-hero compact"><div><span class="eyebrow">Director decision required</span><h1>R @Model.Amount.ToString("N2") · @Model.ExpenseType</h1><p>@Model.Attorney.FullName · @Model.Case.CaseNumber · @Model.ExpenseDate.ToString("dd MMM yyyy")</p></div></div>
<div class="workspace-grid"><section class="surface"><h2>Evidence and accepted event</h2><p>@Model.Description</p><p><b>Client-approved event:</b> @Model.MatchedActivityType #@Model.MatchedActivityId</p><p><b>Amount claimed:</b> R @Model.Amount.ToString("N2")</p><p><b>Policy limit:</b> R @Model.PolicyLimitSnapshot.ToString("N2")</p><p><b>Classification:</b> @Model.Classification</p><p class="muted">@Model.ClassificationReason</p><a class="btn-secondary-modern" href="/Reimbursement/DownloadProof/@Model.Id">Open proof</a></section><section class="surface"><h2>Record final verdict</h2><form method="post" action="/Reimbursement/Decide" class="stack-form">@Html.AntiForgeryToken()<input type="hidden" name="ClaimId" value="@Model.Id"/><label>Amount approved for payment (R)<input type="number" name="ApprovedAmount" value="@Model.Amount" min="0.01" max="@Model.Amount" step="0.01" required/></label><label>Director's reason<textarea name="Reason" minlength="5" rows="5" required placeholder="Explain the amount approved or why the claim is refused."></textarea></label><div class="estimate-actions"><button class="btn-primary-modern" name="Approve" value="true">Approve selected amount</button><button class="btn-secondary-modern" name="Approve" value="false">Refuse claim</button></div></form></section></div>
