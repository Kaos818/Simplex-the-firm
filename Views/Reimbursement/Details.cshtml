@model SimplexLawFirm.Models.ReimbursementClaim
@{ ViewData["Title"]="Reimbursement "+Model.ClaimNumber; Layout=Context.Session.GetString("UserRole")=="Admin"?"_AdminLayout":"_LawyerLayout"; var approved=Model.Status is ReimbursementStatus.AutoApproved or ReimbursementStatus.Approved; }
<div class="breadcrumb-line"><a href="@(Context.Session.GetString("UserRole")=="Admin"?"/Reimbursement/DirectorQueue":"/Reimbursement")">Reimbursements</a><span>/</span><span>@Model.ClaimNumber</span></div>
<div class="page-hero compact"><div><span class="eyebrow">@Model.Status</span><h1>@Model.ExpenseType · R @Model.Amount.ToString("N2")</h1><p>@Model.Case.CaseNumber · paid @Model.ExpenseDate.ToString("dd MMMM yyyy")</p></div><span class="status-pill large">@Model.Classification</span></div>
@if(Model.Status==ReimbursementStatus.RefusedValidation){<div class="surface disclaimer-panel"><div><span class="eyebrow">Claim refused</span><h2>Required supporting activity was not established.</h2><p>@Model.ValidationFailureReason</p></div></div>}
<div class="workspace-grid"><section class="surface"><h2>Claim evidence</h2><p>@Model.Description</p><dl><dt>Matched activity</dt><dd>@(Model.MatchedActivityType?.ToString() ?? "None") @(Model.MatchedActivityId.HasValue?$"#{Model.MatchedActivityId}":"")</dd><dt>Proof</dt><dd>@if(Model.ProofRelativePath!=null){<a href="/Reimbursement/DownloadProof/@Model.Id">@Model.ProofOriginalFileName</a>}else{<span>Not uploaded</span>}</dd><dt>Policy limit</dt><dd>R @Model.PolicyLimitSnapshot.ToString("N2") @if(Model.ExceedsPolicyLimit){<b class="text-danger">— exceeded</b>}</dd></dl></section><section class="surface"><h2>Financial treatment</h2><p><b>@Model.Classification</b></p><p class="muted">@Model.ClassificationReason</p>@if(approved){<div class="responsibility-note">Payable to @Model.Attorney.FullName: <b>R @Model.Payable?.Amount.ToString("N2")</b></div>@if(Model.Disbursement!=null){<div class="responsibility-note">Client disbursement: @(Model.Disbursement.InvoiceId.HasValue?$"added to invoice {Model.Disbursement.Invoice?.InvoiceNumber}":"queued for the next invoice")</div>}}@if(Model.DecisionReason!=null){<p><b>Decision reason:</b> @Model.DecisionReason</p>}</section></div>
<section class="surface"><div class="section-heading"><h2>Audit trail</h2></div>@foreach(var entry in Model.AuditEntries.OrderByDescending(x=>x.RecordedAtUtc)){<div class="record-row"><span><b>@entry.Action</b><small>@entry.Details</small></span><small>@entry.RecordedAtUtc.ToString("dd MMM yyyy HH:mm") UTC</small></div>}</section>
