@model IEnumerable<SimplexLawFirm.Models.ExpensePolicy>
@{ ViewData["Title"]="Reimbursement policy"; Layout="_AdminLayout"; var terms=(IEnumerable<SimplexLawFirm.Models.MatterExpenseTerm>)ViewBag.MatterTerms; }
<div class="page-hero compact"><div><span class="eyebrow">Firm controls</span><h1>Reimbursement policy</h1><p>Maintain per-item limits, delegated authority and the default client-recovery treatment.</p></div><a class="btn-secondary-modern" href="/Reimbursement/DirectorQueue">Approval queue</a></div>
<section class="surface"><div class="section-heading"><h2>Expense rules</h2></div>@foreach(var policy in Model){<form method="post" action="/Reimbursement/UpdatePolicy" class="record-row">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@policy.Id"/><span><b>@policy.ExpenseType</b><small>Current default: @policy.DefaultClassification</small></span><label>Policy limit<input type="number" name="perItemLimit" value="@policy.PerItemLimit" min="0.01" step="0.01"/></label><label>Delegated limit<input type="number" name="delegatedApprovalLimit" value="@policy.DelegatedApprovalLimit" min="0.01" step="0.01"/></label><select name="defaultClassification" asp-items="Html.GetEnumSelectList<SimplexLawFirm.Models.ExpenseClassification>()"><option selected value="@policy.DefaultClassification">@policy.DefaultClassification</option></select><button class="btn-secondary-modern">Save</button></form>}</section>
<div class="workspace-grid"><section class="surface"><h2>Add or amend matter term</h2><form method="post" action="/Reimbursement/SetMatterTerm" class="stack-form">@Html.AntiForgeryToken()<label>Matter<select name="caseId" required><option value="">Select matter</option>@foreach(var matter in ViewBag.Cases){<option value="@matter.Id">@matter.CaseNumber — @matter.Title</option>}</select></label><label>Expense type<select name="expenseType" asp-items="Html.GetEnumSelectList<SimplexLawFirm.Models.ReimbursementExpenseType>()"></select></label><label>Treatment<select name="classification" asp-items="Html.GetEnumSelectList<SimplexLawFirm.Models.ExpenseClassification>()"></select></label><label>Supporting matter term<textarea name="reason" required rows="3"></textarea></label><button class="btn-primary-modern">Save matter treatment</button></form></section><section class="surface"><h2>Current matter terms</h2>@if(!terms.Any()){<p class="muted">No matter-specific overrides.</p>}@foreach(var term in terms){<div class="record-row"><span><b>@term.Case.CaseNumber · @term.ExpenseType</b><small>@term.Reason</small></span><span class="status-pill">@term.Classification</span></div>}</section></div>
