@model IEnumerable<SimplexLawFirm.Models.ReimbursementClaim>
@{ ViewData["Title"]="My reimbursement claims"; Layout="_LawyerLayout"; }
<div class="page-hero compact"><div><span class="eyebrow">Out-of-pocket expenses</span><h1>My reimbursements</h1><p>Track repayment and whether each approved expense will be recovered from the client or absorbed by the firm.</p></div><a class="btn-primary-modern" asp-controller="Reimbursement" asp-action="Create">New claim</a></div>
<div class="metric-grid"><div class="metric-card"><span>Awaiting proof or review</span><strong>@Model.Count(x=>x.Status is ReimbursementStatus.DraftProofRequired or ReimbursementStatus.PendingDirector)</strong></div><div class="metric-card"><span>Approved</span><strong>@Model.Count(x=>x.Status is ReimbursementStatus.AutoApproved or ReimbursementStatus.Approved)</strong></div><div class="metric-card"><span>Client recoverable</span><strong>@Model.Count(x=>x.Disbursement!=null)</strong></div></div>
<section class="surface"><div class="section-heading"><h2>All claims</h2></div>@if(!Model.Any()){<p class="muted">No reimbursement claims yet.</p>}@foreach(var claim in Model){<a class="record-row" href="/Reimbursement/Details/@claim.Id"><span><b>@claim.ClaimNumber · @claim.ExpenseType</b><small>@claim.Case.CaseNumber · @claim.ExpenseDate.ToString("dd MMM yyyy") · @claim.Classification</small></span><span><b>R @claim.Amount.ToString("N2")</b><small class="status-pill">@claim.Status</small></span></a>}</section>
