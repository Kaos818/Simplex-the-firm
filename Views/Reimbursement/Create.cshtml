@model SimplexLawFirm.ViewModels.BeginReimbursementViewModel
@{ ViewData["Title"]="New reimbursement claim"; Layout="_LawyerLayout"; }
<div class="breadcrumb-line"><a href="/Reimbursement">Reimbursements</a><span>/</span><span>New claim</span></div>
<div class="page-hero compact"><div><span class="eyebrow">Step 1 of 2</span><h1>Claim against an accepted event.</h1><p>The event must have been accepted by the client, assigned to you, and already concluded.</p></div></div>
<form method="post" class="surface guided-form">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation-summary"></div><div class="form-section"><span>Client-approved event expense</span><label>Accepted completed event<select asp-for="CalendarEventId" required><option value="">Select the event this expense relates to</option>@foreach(var item in ViewBag.Events){<option value="@item.Id">@item.EndDateTime.ToString("dd MMM yyyy") · @item.Case.CaseNumber · @item.Title · @item.Client.FullName</option>}</select></label><label>Matter<select asp-for="CaseId" required><option value="">Select your assigned matter</option>@foreach(var matter in ViewBag.Cases){<option value="@matter.Id">@matter.CaseNumber — @matter.Title</option>}</select></label><label>Expense type<select asp-for="ExpenseType" asp-items="Html.GetEnumSelectList<SimplexLawFirm.Models.ReimbursementExpenseType>()"></select></label><label>Date paid<input asp-for="ExpenseDate" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")"/></label><label>Amount claimed (R)<input asp-for="Amount" type="number" min="0.01" step="0.01"/></label><label>Description<textarea asp-for="Description" rows="4" placeholder="Explain what was purchased for the accepted event and why it was necessary."></textarea></label></div><div class="responsibility-note">A Director reviews the proof and sets the final reimbursable amount.</div><button class="btn-primary-modern">Verify event and continue</button></form>
