@model SimplexLawFirm.ViewModels.BeginReimbursementViewModel
@{ ViewData["Title"]="New reimbursement claim"; Layout="_LawyerLayout"; }
<div class="breadcrumb-line"><a href="/Reimbursement">Reimbursements</a><span>/</span><span>New claim</span></div>
<div class="page-hero compact"><div><span class="eyebrow">Step 1 of 2</span><h1>Verify the expense against the work.</h1><p>The claim can proceed only if the diary or time record confirms activity on the selected date.</p></div></div>
<form method="post" class="surface guided-form">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation-summary"></div><div class="form-section"><span>Expense</span><label>Matter<select asp-for="CaseId" required><option value="">Select your assigned matter</option>@foreach(var matter in ViewBag.Cases){<option value="@matter.Id">@matter.CaseNumber — @matter.Title</option>}</select></label><label>Expense type<select asp-for="ExpenseType" asp-items="Html.GetEnumSelectList<SimplexLawFirm.Models.ReimbursementExpenseType>()"></select></label><label>Date paid<input asp-for="ExpenseDate" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")"/></label><label>Amount (R)<input asp-for="Amount" type="number" min="0.01" step="0.01"/></label><label>Description<textarea asp-for="Description" rows="4" placeholder="Explain what was purchased and why it was required for the matter."></textarea></label></div><button class="btn-primary-modern">Verify activity and continue</button></form>
