@using Microsoft.AspNetCore.Http
@{ ViewData["Title"] = "Paralegal Dashboard"; Layout = "_ParalegalLayout"; }
<div class="container-fluid">
    <h1 class="mb-2">Paralegal Dashboard</h1>
    <p class="lead">Welcome, @Context.Session.GetString("UserFullName").</p>
    <div class="row g-4 mt-2">
        <div class="col-md-4"><div class="card shadow-sm h-100"><div class="card-body"><i class="fas fa-tasks fa-2x text-info mb-3"></i><h2 class="h5">My tasks</h2><p>Review and update assigned legal work.</p><a class="btn btn-info" href="/Calendar/Tasks">Open tasks</a></div></div></div>
        <div class="col-md-4"><div class="card shadow-sm h-100"><div class="card-body"><i class="fas fa-folder fa-2x text-info mb-3"></i><h2 class="h5">Documents</h2><p>File and retrieve matter documents.</p><a class="btn btn-info" href="/Document/Index">Open documents</a></div></div></div>
        <div class="col-md-4"><div class="card shadow-sm h-100"><div class="card-body"><i class="fas fa-gavel fa-2x text-info mb-3"></i><h2 class="h5">Cases and notes</h2><p>Review the matters your team supports.</p><a class="btn btn-info" href="/Case/Index">Open cases</a></div></div></div>
    </div>
</div>
