@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Lawyer Dashboard";
    Layout = "_LawyerLayout";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="display-4 mb-4">Lawyer Dashboard</h1>
            <p class="lead">Welcome back, @Context.Session.GetString("UserFullName")!</p>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-3 mb-4">
            <div class="card bg-primary text-white shadow-lg">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">My Cases</h6>
                            <h2 class="mb-0">@ViewBag.MyCases</h2>
                        </div>
                        <i class="fas fa-gavel fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card bg-warning text-white shadow-lg">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Pending Approvals</h6>
                            <h2 class="mb-0">@ViewBag.PendingApprovals</h2>
                        </div>
                        <i class="fas fa-check-double fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card bg-info text-white shadow-lg">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Upcoming Events</h6>
                            <h2 class="mb-0">@ViewBag.UpcomingEvents</h2>
                        </div>
                        <i class="fas fa-calendar-alt fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card bg-success text-white shadow-lg">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Unbilled Hours</h6>
                            <h2 class="mb-0">@ViewBag.UnbilledHours</h2>
                        </div>
                        <i class="fas fa-hourglass-half fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-lg">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/Retainer/PendingApprovals" class="btn btn-warning"><i class="fas fa-check-double"></i> Review Pending Retainers</a>
                        <a href="/Billing/TimeEntries/Add" class="btn btn-info"><i class="fas fa-clock"></i> Log Billable Hours</a>
                        <a href="/Calendar" class="btn btn-primary"><i class="fas fa-calendar-alt"></i> View My Schedule</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card shadow-lg">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Recent Activity</h5>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        <div class="list-group-item">
                            <small class="text-muted">Today</small>
                            <div>No pending tasks for today</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
