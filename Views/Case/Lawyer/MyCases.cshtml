@model IEnumerable<Case>
@{
    Layout = "~/Views/Shared/_LawyerLayout.cshtml";
}

<h3 class="mb-4">My Cases</h3>

<a href="/Case/LawyerCreate" class="btn btn-primary mb-3">
    <i class="fas fa-plus"></i> New Case
</a>

<table class="table table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Case #</th>
            <th>Title</th>
            <th>Client</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.CaseNumber</td>
                <td>@c.Title</td>
                <td>@c.Client?.FullName</td>
                <td><span class="badge bg-info">@c.Status</span></td>
                <td>
                    <a href="/Case/Details/@c.Id" class="btn btn-sm btn-outline-primary">View</a>
                    <a href="/Case/LawyerEdit/@c.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>