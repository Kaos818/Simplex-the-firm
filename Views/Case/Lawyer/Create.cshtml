@model Case
@{
    Layout = "~/Views/Shared/_LawyerLayout.cshtml";
}

<h3 class="mb-4">Open New Case</h3>

<form asp-action="LawyerCreate" method="post">
    @Html.AntiForgeryToken()

    <!-- 🔥 GLOBAL VALIDATION SUMMARY -->
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="card shadow-sm p-4">
        
        <!-- Title -->
        <div class="mb-3">
            <label class="form-label">Case Title</label>
            <input asp-for="Title" class="form-control" placeholder="Enter case title..." />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <!-- Client -->
        <div class="mb-3">
            <label class="form-label">Client</label>
            <select asp-for="ClientId" asp-items="ViewBag.Clients" class="form-control">
                <option value="">-- Select Client --</option>
            </select>
            <span asp-validation-for="ClientId" class="text-danger"></span>
        </div>

        <!-- Description -->
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="4"
                      placeholder="Describe the case..."></textarea>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-md-6"><label class="form-label">Case type *</label><input asp-for="CaseType" class="form-control" required /></div>
            <div class="col-md-6"><label asp-for="MatterValue" class="form-label">Matter value *</label><input asp-for="MatterValue" type="number" min="1" step="0.01" class="form-control" required /></div>
            <div class="col-md-6"><label class="form-label">Evidence strength</label><input asp-for="EvidenceStrength" class="form-range" type="range" min="0" max="1" step="0.05" /></div>
        </div>

        <!-- Buttons -->
        <div class="d-flex justify-content-between">
            <a href="/Case/MyCases" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back
            </a>

            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Create Case
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
