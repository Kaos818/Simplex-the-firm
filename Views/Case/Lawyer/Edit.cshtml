@model Case
@{
    Layout = "~/Views/Shared/_LawyerLayout.cshtml";
}

<h3>Edit Case</h3>

<form asp-action="LawyerEdit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label>Title</label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Status</label>
        <select asp-for="Status" class="form-control">
            @foreach (var s in Enum.GetValues(typeof(CaseStatus)))
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>
    <div class="mb-3"><label>Case type</label><input asp-for="CaseType" class="form-control" required /></div>
    <div class="mb-3"><label>Evidence strength</label><input asp-for="EvidenceStrength" class="form-range" type="range" min="0" max="1" step="0.05" /></div>

    <button class="btn btn-warning">Update</button>
</form>
