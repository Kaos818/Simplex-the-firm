@model IEnumerable<SimplexLawFirm.Models.Case>
@{ ViewData["Title"] = "My Cases"; Layout = "_ClientLayout"; }
<div class="container py-4"><h1>My Cases</h1><p class="text-muted">Only matters belonging to your client profile are displayed.</p>
@if (!Model.Any()) { <div class="alert alert-info">No matters are linked to your account.</div> }
else { <div class="row">@foreach (var item in Model) { <div class="col-lg-6 mb-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="d-flex justify-content-between"><h5>@item.Title</h5><span class="badge bg-primary">@item.Status</span></div><p class="text-muted">@item.CaseNumber</p><a class="btn btn-outline-primary" href="/Case/Details/@item.Id">View my matter</a></div></div></div> }</div> }
</div>
