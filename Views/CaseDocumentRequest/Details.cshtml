@model SimplexLawFirm.Models.CaseDocumentRequest
@{ Layout=Context.Session.GetString("UserRole")=="Lawyer"?"_LawyerLayout":"_AdminLayout"; }
<div class="breadcrumb-line"><a href="/Case/Details/@Model.CaseId">@Model.Case.CaseNumber</a><span>/</span><span>Document request</span></div>
<div class="page-hero compact"><div><span class="eyebrow">@Model.RequestType response · @Model.Status</span><h1>@Model.Title</h1><p>Requested from @Model.Client.FullName by @Model.RequestedByAttorney.FullName</p></div></div>
<div class="workspace-grid"><section class="surface"><h2>Requested response</h2>@if(Model.RequestType==ClientResponseRequestType.Document){<p style="white-space:pre-wrap">@Model.RequiredDocuments</p>}<p>@Model.Instructions</p><small>Due @Model.DueAtUtc.ToString("dd MMM yyyy") · @Model.ResponseSlaDaysSnapshot-day SLA</small>@if(Model.LastDelayAction is not null){<hr/><b>Latest delay action: @Model.LastDelayAction</b><p>@Model.LastDelayActionNote</p>}</section><section class="surface"><h2>@(Model.RequestType==ClientResponseRequestType.Document?"Client uploads":"Client response")</h2>@if(!string.IsNullOrWhiteSpace(Model.ClientResponseText)){<p style="white-space:pre-wrap">@Model.ClientResponseText</p>}@if(!Model.Documents.Any() && string.IsNullOrWhiteSpace(Model.ClientResponseText)){<p class="muted">Nothing received yet.</p>}@foreach(var d in Model.Documents){<a class="record-row" href="/Document/Download/@d.Id"><span><b>@d.FileName</b><small>@d.UploadedAt.ToString("dd MMM yyyy HH:mm")</small></span><span>Download</span></a>}</section></div>
@if(Model.Status==CaseDocumentRequestStatus.Overdue){<form method="post" action="/CaseDocumentRequest/RecordDelayAction" class="surface stack-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><h2>Action overdue response</h2><label>Action<select name="action"><option value="FollowUp">Follow up with client</option><option value="Escalated">Escalate</option><option value="DeadlineExtended">Extend deadline</option></select></label><label>New deadline <span class="muted">(only for an extension)</span><input name="extendedDeadlineUtc" type="datetime-local" /></label><label>Action record<textarea name="note" required rows="3" placeholder="Record what was done and why"></textarea></label><button class="btn-primary-modern">Record action</button></form>}
@if(Model.Status==CaseDocumentRequestStatus.Submitted){<form method="post" action="/CaseDocumentRequest/Review" class="surface stack-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><h2>Review response</h2><label>Feedback<textarea name="feedback" rows="4" placeholder="If anything is missing, explain exactly what the client must add"></textarea></label><div class="d-flex gap-2"><button name="accepted" value="true" class="btn-primary-modern">Accept documents</button><button name="accepted" value="false" class="btn-secondary-modern">Request missing documents</button></div></form>}
