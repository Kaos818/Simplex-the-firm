@model SimplexLawFirm.Models.CaseDocumentRequest
@{ Layout="_ClientLayout"; }
<div class="breadcrumb-line"><a href="/Case/MyCases">My cases</a><span>/</span><span>@Model.Case.CaseNumber</span></div>
<div class="page-hero compact"><div><span class="eyebrow">Document request · @Model.Status</span><h1>@Model.Title</h1><p>@Model.RequestedByAttorney.FullName requested documents for @Model.Case.Title.</p></div></div>
@if(Model.Status==CaseDocumentRequestStatus.MoreInformationRequired){<div class="alert alert-warning"><strong>Missing documentation must be uploaded</strong><p>@Model.ReviewFeedback</p><a class="btn btn-warning" href="#missingFileUpload"><i class="fas fa-upload me-1"></i>Reupload missing files</a></div>}
@if(Model.Status==CaseDocumentRequestStatus.Accepted){<div class="alert alert-success">Your lawyer accepted this document response.</div>}
<div class="workspace-grid"><section class="surface"><h2>What to provide</h2>@if(Model.RequestType==ClientResponseRequestType.Document){<p style="white-space:pre-wrap">@Model.RequiredDocuments</p>}<p>@Model.Instructions</p><small>Due @Model.DueAtUtc.ToString("dd MMM yyyy") · @Model.ResponseSlaDaysSnapshot-day SLA</small></section><section class="surface"><h2>@(Model.RequestType==ClientResponseRequestType.Document?"Your uploaded documents":"Your response")</h2>@if(!string.IsNullOrWhiteSpace(Model.ClientResponseText)){<p style="white-space:pre-wrap">@Model.ClientResponseText</p>}@foreach(var d in Model.Documents){<a class="record-row" href="/Document/Download/@d.Id"><span><b>@d.FileName</b><small>@d.UploadedAt.ToString("dd MMM yyyy HH:mm")</small></span><span>Download</span></a>}@if(Model.Status!=CaseDocumentRequestStatus.Accepted && Model.RequestType==ClientResponseRequestType.Document){<form id="missingFileUpload" method="post" action="/CaseDocumentRequest/Upload" enctype="multipart/form-data" class="stack-form mt-3">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><label>Select files<input type="file" name="files" multiple required accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.txt"/></label><button class="btn-primary-modern">Upload and notify lawyer</button></form>}@if(Model.Status!=CaseDocumentRequestStatus.Accepted && Model.RequestType!=ClientResponseRequestType.Document){<form method="post" action="/CaseDocumentRequest/SubmitResponse" class="stack-form mt-3">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><label>Your response<textarea name="responseText" required rows="5"></textarea></label><button class="btn-primary-modern">Submit response</button></form>}</section></div>
