@{ ViewData["Title"] = "Choose a new password"; Layout = null; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Choose a new password - Simplex Law</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body class="auth-page"><main class="auth-shell"><section class="auth-story"><a asp-action="Index" class="brand-lockup"><span class="brand-mark">S</span><span><b>Simplex</b><small>Legal workspace</small></span></a><div><span class="eyebrow">Secure recovery</span><h1>Choose a fresh,<br/>strong password.</h1><p>Your reset link works once and expires after 24 hours.</p></div></section>
<section class="auth-panel"><div class="auth-card"><h2>New password</h2>@if(TempData["Error"] != null){<div class="alert alert-danger">@TempData["Error"]</div>}
<form asp-action="ResetPassword" method="post" class="stack-form"><input type="hidden" name="token" value="@ViewBag.Token"/><label>New password<input type="password" name="password" autocomplete="new-password" minlength="12" required/></label><label>Confirm new password<input type="password" name="confirmPassword" autocomplete="new-password" minlength="12" required/></label><p class="muted">At least 12 characters with uppercase, lowercase, a number and a symbol.</p><button type="submit" class="btn-primary-modern auth-submit">Save new password</button></form></div></section></main></body></html>
