@{ ViewData["Title"] = "Forgot password"; Layout = null; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Forgot password - Simplex Law</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body class="auth-page"><main class="auth-shell"><section class="auth-story"><a asp-action="Index" class="brand-lockup"><span class="brand-mark">S</span><span><b>Simplex</b><small>Legal workspace</small></span></a><div><span class="eyebrow">Account recovery</span><h1>Let’s get you<br/>back inside.</h1><p>We’ll email a private, time-limited link that lets you choose a new password.</p></div></section>
<section class="auth-panel"><div class="auth-card"><span class="eyebrow">Password help</span><h2>Reset your password</h2><p class="muted">Enter the email address linked to your account.</p>
<form asp-action="ForgotPassword" method="post" class="stack-form"><label>Email address<input type="email" name="emailAddress" autocomplete="email" required autofocus/></label><button type="submit" class="btn-primary-modern auth-submit">Email reset link</button></form><p class="auth-footer"><a asp-action="Login">Back to sign in</a></p></div></section></main></body></html>
