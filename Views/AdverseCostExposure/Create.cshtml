@model SimplexLawFirm.Models.AdverseCostExposure
@{ Layout="_LawyerLayout"; var matter=(SimplexLawFirm.Models.Case)ViewBag.Case; var orders=(IReadOnlyList<SimplexLawFirm.Models.Document>)ViewBag.CourtOrders; }
<div class="page-hero compact"><div><span class="eyebrow">Court order against client</span><h1>Log adverse cost exposure</h1><p>@matter.CaseNumber · @matter.Title</p></div></div>
@if(!orders.Any()){<div class="alert alert-warning">Upload the court ruling/order to this matter as a Court Order document before logging exposure.</div>}<form method="post" class="surface stack-form">@Html.AntiForgeryToken()<input type="hidden" asp-for="CaseId"/><label>Court ruling / order<select asp-for="CourtOrderDocumentId" required><option value="">Select uploaded court order</option>@foreach(var order in orders){<option value="@order.Id">@order.FileName · @order.UploadedAt.ToString("dd MMM yyyy")</option>}</select></label><label>Issuing court<input asp-for="IssuingCourt" required placeholder="e.g. Durban High Court"/></label><label>Ruling date<input asp-for="RulingDateUtc" type="date" required/></label><label>Cost order amount<input asp-for="CostOrderAmount" type="number" min="0.01" step="0.01" required/></label><button class="btn-primary-modern" disabled="@(!orders.Any())">Log and calculate exposure</button></form>
