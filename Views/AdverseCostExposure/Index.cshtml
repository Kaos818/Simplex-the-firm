@model IReadOnlyList<SimplexLawFirm.Models.AdverseCostExposure>
@{ Layout = ViewBag.Role == "Lawyer" ? "_LawyerLayout" : ViewBag.Role == "Accountant" ? "_AccountantLayout" : "_AdminLayout"; ViewData["Title"]="Adverse cost exposure"; }
<div class="page-hero compact"><div><span class="eyebrow">Use case 03</span><h1>Adverse cost exposure</h1><p>Track court orders against a client, available trust cover, shortfall, and the path to resolution.</p></div></div>
<section class="surface"><div class="section-heading"><div><span class="eyebrow">Exposure register</span><h2>@Model.Count item(s)</h2></div></div>@if(!Model.Any()){<div class="empty-state">No adverse cost exposures are visible in your scope.</div>}@foreach(var item in Model){<a class="record-row" href="/AdverseCostExposure/Details/@item.Id"><span><b>@item.Case.CaseNumber · @item.IssuingCourt</b><small>Exposure R @item.TotalExposure.ToString("N2") · shortfall R @item.Shortfall.ToString("N2")</small></span><span class="status-pill">@item.Status</span></a>}</section>
