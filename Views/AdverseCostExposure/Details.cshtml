@model SimplexLawFirm.Models.AdverseCostExposure
@using SimplexLawFirm.Models
@{ var role=(string)ViewBag.Role; Layout=role=="Lawyer"?"_LawyerLayout":role=="Accountant"?"_AccountantLayout":"_AdminLayout"; }
<div class="page-hero compact"><div><span class="eyebrow">@Model.Status</span><h1>@Model.Case.CaseNumber · adverse cost exposure</h1><p>@Model.IssuingCourt ruling of @Model.RulingDateUtc.ToString("dd MMM yyyy")</p></div></div>
<div class="metric-grid"><div class="metric-card"><span>Cost order</span><strong>R @Model.CostOrderAmount.ToString("N2")</strong></div><div class="metric-card"><span>Existing case costs</span><strong>R @Model.ExistingCaseCostsSnapshot.ToString("N2")</strong></div><div class="metric-card"><span>Total exposure</span><strong>R @Model.TotalExposure.ToString("N2")</strong></div><div class="metric-card"><span>Retainer/trust cover</span><strong>R @Model.AvailableTrustRetainerSnapshot.ToString("N2")</strong><small>Shortfall: R @Model.Shortfall.ToString("N2")</small></div></div>
<section class="surface"><h2>Evidence and review record</h2><p><a href="/Document/Download/@Model.CourtOrderDocumentId">@Model.CourtOrderDocument.FileName</a></p><p><b>Accountant:</b> @(Model.AccountantReviewedAtUtc is null ? "Awaiting review" : $"Reviewed {Model.AccountantReviewedAtUtc:dd MMM yyyy}: {Model.ProgressNote}")</p><p><b>Director:</b> @(Model.DirectorReviewedAtUtc is null ? "Awaiting position" : Model.DirectorPosition)</p>@if(Model.RevisedAmount is not null){<p><b>Current revised amount:</b> R @Model.RevisedAmount.Value.ToString("N2")</p>}@if(Model.FinalSettledAmount is not null){<p><b>Final settled amount:</b> R @Model.FinalSettledAmount.Value.ToString("N2")</p>}</section>
@if(role=="Lawyer" && Model.ResolvedAtUtc is null){<form method="post" action="/AdverseCostExposure/Progress" class="surface stack-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><h2>Negotiation or taxation update</h2><label>Process<select name="status"><option value="Negotiation">Negotiation</option><option value="Taxation">Formal taxation</option></select></label><label>Revised amount<input name="revisedAmount" type="number" min="0.01" step="0.01" required/></label><label>Current position<textarea name="note" required></textarea></label><button class="btn-primary-modern">Record progress</button></form><form method="post" action="/AdverseCostExposure/Resolve" class="surface stack-form mt-3">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><h2>Resolve exposure</h2><label>Final settled amount<input name="settledAmount" type="number" min="0" step="0.01" required/></label><label>Resolution note<textarea name="note" required></textarea></label><button class="btn-secondary-modern">Close exposure</button></form>}
@if(role=="Accountant"){<form method="post" action="/AdverseCostExposure/AccountantReview" class="surface stack-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><h2>Accountant review</h2><textarea name="note" required placeholder="Confirm exposure and retainer/trust shortfall."></textarea><button class="btn-primary-modern">Record review</button></form>}
@if(role is "Director" or "Admin"){<form method="post" action="/AdverseCostExposure/DirectorReview" class="surface stack-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><h2>Director position</h2><textarea name="position" required placeholder="Record the firm's approved position."></textarea><button class="btn-primary-modern">Confirm position</button></form>}
