@model IReadOnlyList<SimplexLawFirm.Models.CaseDocumentWaiver>
@{ Layout="_AdminLayout"; }
<div class="container-fluid py-4">
<h1>Mandatory document waiver queue</h1>
@if (!Model.Any()) { <p class="text-muted">No waiver requests are awaiting a decision.</p> }
@foreach(var item in Model){
<div class="card border-0 shadow-sm mb-3"><div class="card-body">
 <h4>@item.Case.CaseNumber · @item.Requirement.Name</h4>
 <p>@item.Reason</p>
 <form asp-action="DecideWaiver" method="post" class="mb-2">
  @Html.AntiForgeryToken()<input name="id" value="@item.Id" type="hidden"/>
  <textarea name="reason" required class="form-control mb-2" placeholder="Director reasons"></textarea>
  <button name="approve" value="true" class="btn btn-success">Approve waiver</button>
  <button name="approve" value="false" class="btn btn-danger">Refuse waiver</button>
 </form>
 <details>
  <summary class="text-primary" style="cursor:pointer">Or set a deadline and return to the attorney</summary>
  <form asp-action="DecideWaiver" method="post" class="mt-2">
   @Html.AntiForgeryToken()<input name="id" value="@item.Id" type="hidden"/><input type="hidden" name="approve" value="false"/>
   <div class="row g-2">
    <div class="col-md-4"><input type="date" name="deadlineAtUtc" required class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")"/></div>
    <div class="col-md-8"><input type="text" name="reason" required class="form-control" placeholder="What must the attorney do before this deadline?"/></div>
   </div>
   <button type="submit" class="btn btn-warning mt-2">Set Deadline &amp; Return to Attorney</button>
  </form>
 </details>
</div></div>
}
</div>
