@model IReadOnlyList<SimplexLawFirm.Models.CaseDocumentWaiver>
@{ Layout="_AdminLayout"; }
<div class="container-fluid py-4"><h1>Mandatory document waiver queue</h1>@foreach(var item in Model){<div class="card border-0 shadow-sm mb-3"><div class="card-body"><h4>@item.Case.CaseNumber · @item.Requirement.Name</h4><p>@item.Reason</p><form asp-action="DecideWaiver" method="post">@Html.AntiForgeryToken()<input name="id" value="@item.Id" type="hidden"/><textarea name="reason" required class="form-control mb-2" placeholder="Director reasons"></textarea><button name="approve" value="true" class="btn btn-success">Approve waiver</button><button name="approve" value="false" class="btn btn-danger">Refuse waiver</button></form></div></div>}</div>
