@model SimplexLawFirm.Models.LitigationStrategyDecision
@{ Layout="_AdminLayout"; }
<div class="container py-4"><h1>Strategy authorisation</h1><div class="card border-0 shadow-sm"><div class="card-body p-4"><h3>@Model.Case.CaseNumber · @Model.Strategy</h3><dl class="row"><dt class="col-4">Projected cost</dt><dd class="col-8">R @Model.ProjectedCostToCompletion.ToString("N2")</dd><dt class="col-4">Matter value</dt><dd class="col-8">R @Model.MatterValueSnapshot.ToString("N2")</dd><dt class="col-4">Prospects</dt><dd class="col-8">@Model.ProspectsSnapshot.ToString("P0")</dd><dt class="col-4">Attorney reasoning</dt><dd class="col-8">@Model.Reasoning</dd><dt class="col-4">Poor-prospects justification</dt><dd class="col-8">@Model.LowProspectsJustification</dd></dl>@if(Model.Status==SimplexLawFirm.Models.StrategyDecisionStatus.PendingDirectorAuthorisation){<form asp-action="DecideStrategy" method="post">@Html.AntiForgeryToken()<input name="id" value="@Model.Id" type="hidden"/><textarea name="reason" required class="form-control mb-3" rows="4" placeholder="Director reasons"></textarea><button type="submit" name="authorise" value="true" class="btn btn-success">Authorise</button><button type="submit" name="authorise" value="false" class="btn btn-danger">Refuse</button></form>}else{<div class="alert alert-secondary"><b>Decision recorded:</b> @Model.Status. @Model.DirectorReason</div>}</div></div></div>
