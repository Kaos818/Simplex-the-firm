@model IReadOnlyList<SimplexLawFirm.Models.LitigationStrategyDecision>
@{ Layout="_AdminLayout"; }
<div class="container-fluid py-4"><h1>Strategy authorisation queue</h1><p class="text-muted">Cost/value and poor-prospects exceptions requiring Director accountability.</p><div class="card border-0 shadow-sm"><table class="table mb-0"><thead><tr><th>Matter</th><th>Attorney</th><th>Strategy</th><th>Projected cost/value</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Case.CaseNumber</td><td>@item.Attorney.FullName</td><td>@item.Strategy</td><td>R @item.ProjectedCostToCompletion.ToString("N0") / R @item.MatterValueSnapshot.ToString("N0")</td><td><a asp-action="StrategyReview" asp-route-id="@item.Id" class="btn btn-dark btn-sm">Review</a></td></tr>}</tbody></table></div></div>
