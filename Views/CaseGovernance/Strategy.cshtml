@model SimplexLawFirm.ViewModels.SelectLitigationStrategyViewModel
@using SimplexLawFirm.Models
@using SimplexLawFirm.ViewModels
@{ Layout="_LawyerLayout"; var matter=(Case)ViewBag.Case; var options=(IReadOnlyList<StrategyOptionViewModel>)ViewBag.Options; var history=(IReadOnlyList<LitigationStrategyDecision>)ViewBag.History; }
<div class="container-fluid py-4"><div class="d-flex justify-content-between"><div><span class="badge bg-primary">UC11</span><h1>Litigation strategy</h1><p>@matter.CaseNumber · Matter value R @matter.MatterValue.ToString("N2")</p></div><a asp-action="Readiness" asp-route-caseId="@matter.Id" class="btn btn-outline-dark align-self-start">Document readiness</a></div><div class="row g-4"><div class="col-xl-8"><div class="row g-3">@foreach(var option in options){<div class="col-md-6"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><h4>@option.Strategy</h4><p class="display-6">R @option.ProjectedCost.ToString("N0")</p><p>@option.ExpectedDurationDays days · @option.ComparableCount comparable matters</p>@if(option.SettlementLow.HasValue){<small>Recorded settlement range: R @option.SettlementLow.Value.ToString("N0") - R @option.SettlementHigh!.Value.ToString("N0")</small>}else{<small class="text-muted">No comparable settled matters recorded yet.</small>}</div></div></div>}</div></div><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-body"><h4>Record decision</h4><form asp-action="Strategy" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation-summary"></div><input asp-for="CaseId" type="hidden"/><label class="form-label">Strategy</label><select asp-for="Strategy" asp-items="Html.GetEnumSelectList<LitigationStrategyType>()" class="form-select mb-3"></select><label class="form-label">Reasoning</label><textarea asp-for="Reasoning" minlength="20" required rows="5" class="form-control mb-3"></textarea><label class="form-label">Trial justification where prospects are poor</label><textarea asp-for="LowProspectsJustification" rows="4" class="form-control mb-3"></textarea><button type="submit" class="btn btn-primary w-100">Test and record strategy</button></form></div></div></div></div><h3 class="mt-5">Decision history</h3><div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Strategy</th><th>Status</th><th>Cost</th><th>Prospects</th><th>Director reason</th></tr></thead><tbody>@foreach(var item in history){<tr><td>@item.RecordedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>@item.Strategy</td><td>@item.Status</td><td>R @item.ProjectedCostToCompletion.ToString("N2")</td><td>@item.ProspectsSnapshot.ToString("P0")</td><td>@item.DirectorReason</td></tr>}</tbody></table></div></div>
