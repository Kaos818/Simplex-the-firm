@model List<SimplexLawFirm.Models.Document>

@{
    ViewData["Title"] = "Documents";
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2">Documents</h1>
        <a href="/Document/Upload" class="btn btn-primary">
            <i class="fas fa-upload"></i> Upload Document
        </a>
    </div>

    <div class="card shadow-lg">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Size</th>
                            <th>Case</th>
                            <th>Uploaded By</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model)
                        {
                            <tr>
                                <td>@doc.FileName</td>
                                <td>@doc.Category</td>
                                <td>@doc.FileSize</td>
                                <td>@(doc.Case?.Title ?? "General")</td>
                                <td>@doc.UploadedBy?.FullName</td>
                                <td>@doc.UploadedAt.ToString("dd MMM yyyy")</td>
                                <td>
                                    <a href="/Document/Download/@doc.Id" class="btn btn-sm btn-success">
                                        <i class="fas fa-download"></i>
                                    </a>
                                    <a href="/Document/Share/@doc.Id" class="btn btn-sm btn-info">
                                        <i class="fas fa-share"></i>
                                    </a>
                                    <button onclick="deleteDocument(@doc.Id)" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    function deleteDocument(id) {
        if (confirm('Are you sure you want to delete this document?')) {
            $.ajax({
                url: '/Document/Delete/' + id,
                type: 'POST',
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    }
                }
            });
        }
    }
</script>