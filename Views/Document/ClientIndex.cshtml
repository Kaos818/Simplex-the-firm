@model IReadOnlyList<SimplexLawFirm.Models.Document>
@{ Layout = "_ClientLayout"; ViewData["Title"] = "My documents"; }
<div class="container-fluid py-3"><div class="d-flex justify-content-between align-items-end mb-4"><div><span class="badge bg-success-subtle text-success">Complete record</span><h1 class="mt-2">My documents</h1><p class="text-muted mb-0">Past and present documents connected to your matters, including sharing history and purpose.</p></div><a href="/Document/SharedWithMe" class="btn btn-outline-success">Shared with me</a></div><div class="row g-3">@foreach(var document in Model){<div class="col-lg-6"><article class="card border-0 shadow-sm h-100"><div class="card-body"><div class="d-flex justify-content-between"><div><h5>@document.FileName</h5><span class="badge bg-light text-dark">@document.Category</span></div><a asp-action="Download" asp-route-id="@document.Id" class="btn btn-success btn-sm align-self-start">Download</a></div><p class="mt-3 mb-2">@(string.IsNullOrWhiteSpace(document.Description) ? "No purpose was recorded." : document.Description)</p><small class="text-muted">Uploaded @document.UploadedAt.ToString("dd MMM yyyy HH:mm") by @(document.UploadedBy?.FullName ?? "System")</small>@foreach(var share in document.SharedWith?.OrderByDescending(x=>x.SharedAt) ?? Enumerable.Empty<SimplexLawFirm.Models.DocumentShare>()){<hr/><small>Shared by <b>@(share.SharedByUser?.FullName ?? "System")</b> on @share.SharedAt.ToString("dd MMM yyyy HH:mm")</small>}</div></article></div>}@if(Model.Count==0){<div class="col-12"><div class="alert alert-info">No documents are linked to your account yet.</div></div>}</div></div>
