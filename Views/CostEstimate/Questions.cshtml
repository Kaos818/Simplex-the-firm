@model SimplexLawFirm.ViewModels.CreateCostEstimateViewModel
@{ ViewData["Title"]="Tell us about the matter"; Layout="_Layout"; var enquiry=(SimplexLawFirm.Models.CostEstimateEnquiry)ViewBag.Enquiry; }
<div class="public-estimator"><div class="breadcrumb-line"><a href="/CostEstimate">Cost estimator</a><span>/</span><span>@enquiry.MatterType</span></div><div class="page-hero compact"><div><span class="eyebrow">Adequate history confirmed</span><h1>Shape the estimate.</h1><p>These questions help us adjust historical effort for the likely complexity of your matter.</p></div></div>
<form method="post" action="/CostEstimate/Calculate?token=@enquiry.PublicToken" class="surface guided-form">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation-summary"></div><div class="form-section"><span>About you</span><label>Name<input asp-for="ContactName" required/></label><label>Email<input asp-for="Email" type="email" required/></label></div><div class="form-section"><span>Matter profile</span><label>Estimated value in dispute or transaction (R)<input asp-for="MatterValue" type="number" min="0" step="1000"/></label><label>Urgency<select asp-for="Urgency" asp-items="Html.GetEnumSelectList<SimplexLawFirm.Models.MatterUrgency>()"></select></label><label>Documents available<select asp-for="DocumentReadiness" asp-items="Html.GetEnumSelectList<SimplexLawFirm.Models.DocumentReadiness>()"></select></label><label class="check-line"><input asp-for="RequiresCourtProceedings"/> Court proceedings are required or expected</label></div><button class="btn-primary-modern">Create my locked estimate</button></form></div>
