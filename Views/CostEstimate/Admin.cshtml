@model IEnumerable<SimplexLawFirm.Models.MatterCostEstimate>
@{ ViewData["Title"]="Cost estimate governance"; Layout="_AdminLayout"; var gaps=(IEnumerable<SimplexLawFirm.Models.CostEstimateCoverageGap>)ViewBag.Gaps; }
<div class="page-hero compact"><div><span class="eyebrow">Billing governance</span><h1>Cost estimate enquiries</h1><p>Follow up enquiries, close history gaps and maintain the chain from estimate to invoice.</p></div></div>
<div class="metric-grid"><div class="metric-card"><span>Locked estimates</span><strong>@Model.Count(x=>x.Status!=CostEstimateStatus.Declined)</strong></div><div class="metric-card"><span>Coverage gaps</span><strong>@gaps.Count(x=>x.Status==EstimateGapStatus.Open)</strong></div><div class="metric-card"><span>Linked matters</span><strong>@Model.Count(x=>x.LinkedCaseId!=null)</strong></div></div>
<div class="workspace-grid"><section class="surface"><div class="section-heading"><h2>Recent enquiries</h2></div>@foreach(var item in Model){<a class="record-row" href="/CostEstimate/AdminDetails/@item.Id"><span><b>@item.Enquiry.MatterType</b><small>@(string.IsNullOrWhiteSpace(item.Enquiry.ContactName)?"Anonymous enquiry":item.Enquiry.ContactName)</small></span><span class="status-pill">@item.Status</span></a>}</section><section class="surface"><div class="section-heading"><h2>Coverage gaps</h2></div>@foreach(var gap in gaps){<div class="record-row"><span><b>@gap.MatterType</b><small>@gap.Reason</small></span>@if(gap.Status==EstimateGapStatus.Open){<form method="post" action="/CostEstimate/AcknowledgeGap">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@gap.Id"/><button class="btn-secondary-modern">Acknowledge</button></form>}else{<span class="status-pill">Acknowledged</span>}</div>}</section></div>
