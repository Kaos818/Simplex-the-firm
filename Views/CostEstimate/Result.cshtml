@model SimplexLawFirm.Models.MatterCostEstimate
@using SimplexLawFirm.Models
@{
    ViewData["Title"]="Your matter cost estimate"; Layout="_Layout";
    var messages = (List<CostEstimateMessage>)ViewBag.Messages;
}
<div class="public-estimator"><div class="breadcrumb-line"><a href="/CostEstimate">Cost estimator</a><span>/</span><span>Estimate #@Model.Id.ToString("000000")</span></div>
<div class="estimate-result-hero"><span class="eyebrow">Indicative cost range</span><h1>R @Model.TotalLow.ToString("N0") <i>to</i> R @Model.TotalHigh.ToString("N0")</h1><p>@Model.Enquiry.MatterType · based on @Model.ComparableMatterCount comparable closed matters</p><div class="lock-note">🔒 Version @Model.Version locked @Model.LockedAtUtc.ToString("dd MMM yyyy HH:mm") UTC</div></div>
<div class="estimate-breakdown"><div class="surface"><span>Professional fees</span><strong>R @Model.ProfessionalFeesLow.ToString("N0") - R @Model.ProfessionalFeesHigh.ToString("N0")</strong><small>Current charge-out rates applied to historical effort</small></div><div class="surface"><span>Expected disbursements</span><strong>R @Model.DisbursementsLow.ToString("N0") - R @Model.DisbursementsHigh.ToString("N0")</strong><small>Expected third-party and filing costs</small></div><div class="surface"><span>VAT</span><strong>R @Model.VatLow.ToString("N0") - R @Model.VatHigh.ToString("N0")</strong><small>Calculated at 15%</small></div></div>
<div class="surface disclaimer-panel"><div><span class="eyebrow">Important</span><h2>This estimate is not binding.</h2><p>It reflects the assumptions and rates recorded today. Changes in scope, evidence or procedure can affect the final cost. Simplex retains this locked estimate and requires Director authorisation if the eventual invoice falls outside the permitted range and tolerance.</p></div><div class="estimate-actions"><a class="btn-primary-modern" href="/CostEstimate/Download?token=@Model.Enquiry.PublicToken">Download PDF</a><form method="post" action="/CostEstimate/BookConsultation?token=@Model.Enquiry.PublicToken">@Html.AntiForgeryToken()<button class="btn-secondary-modern">Book a consultation</button></form></div></div>

<div class="surface mt-3">
 <span class="eyebrow">Questions?</span><h2>Chat with Admin</h2>
 @if (!messages.Any()) {
  <p class="muted">Have a question about this estimate? Send a message and our team will reply here and by email.</p>
 } else {
  <div class="d-flex flex-column gap-2 mb-3">
   @foreach (var m in messages) {
    <div class="record-row" style="@(m.IsFromAdmin ? "background:#eef6ff" : "")">
     <span><b>@(m.IsFromAdmin ? "Simplex team" : m.SenderName)</b><small>@m.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small><br/>@m.Body</span>
    </div>
   }
  </div>
 }
 <form method="post" action="/CostEstimate/SendMessage" class="stack-form">
  @Html.AntiForgeryToken()<input type="hidden" name="token" value="@Model.Enquiry.PublicToken"/>
  <label>Your name<input class="form-control" name="senderName" value="@Model.Enquiry.ContactName"/></label>
  <label>Message<textarea class="form-control" name="body" rows="3" required placeholder="Ask us anything about this estimate…"></textarea></label>
  <button type="submit" class="btn-secondary-modern">Send message</button>
 </form>
</div>
</div>
