@model SimplexLawFirm.Models.MatterCostEstimate
@{ ViewData["Title"]="Consultation recommended"; Layout="_Layout"; }
<div class="public-estimator"><div class="page-hero compact"><div><span class="eyebrow">No adequate estimation basis</span><h1>Let’s not guess.</h1><p>@Model.DeclineReason</p></div></div><div class="form-shell"><div class="surface"><h2>Book a consultation instead</h2><p class="muted">A legal professional can understand the scope before discussing likely cost. The estimation gap has been recorded for our Director.</p><form method="post" action="/CostEstimate/BookConsultation?token=@Model.Enquiry.PublicToken" class="stack-form">@Html.AntiForgeryToken()<label>Your name<input name="contactName" value="@Model.Enquiry.ContactName" required/></label><label>Email<input name="emailAddress" type="email" value="@Model.Enquiry.Email" required/></label><button class="btn-primary-modern">Request consultation</button></form></div></div></div>
