@{
    ViewData["Title"] = "Book a consultation";
    var lawyers = ViewBag.Lawyers as IEnumerable<SimplexLawFirm.Models.ApplicationUser> ?? [];
    var slots = ViewBag.Slots as IEnumerable<DateTime> ?? [];
    var specialties = ViewBag.Specialties as Dictionary<int, string> ?? [];
    var professions = ViewBag.ProfessionOptions as IEnumerable<string> ?? [];
}

<h1>Book a consultation</h1>
<p>Weekdays 09:00–16:00, 60 minutes. Times are shown in Africa/Johannesburg. Fee: R 1,500.00. A lawyer must approve your booking before it is billable.</p>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-3">
        <label class="form-label" for="specialty">Legal profession</label>
        <select class="form-select" id="specialty" name="specialty">
            <option value="">All legal professions</option>
            @foreach (var profession in professions)
            {
                <option value="@profession" selected="@(ViewBag.SelectedSpecialty == profession)">@profession</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label" for="lawyerId">Lawyer and specialty</label>
        <select class="form-select" id="lawyerId" name="lawyerId" required>
            <option value="">Choose a lawyer</option>
            @foreach (var lawyer in lawyers)
            {
                <option value="@lawyer.Id" selected="@(ViewBag.SelectedLawyerId == lawyer.Id)">@lawyer.FullName — @specialties.GetValueOrDefault(lawyer.Id, "General practice")</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label" for="date">Appointment date</label>
        <input class="form-control" id="date" type="date" name="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@(((DateTime)ViewBag.SelectedDate).ToString("yyyy-MM-dd"))" required />
    </div>
    <div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary">Show free times</button></div>
</form>

@if (ViewBag.SelectedLawyerId is not null)
{
    <div class="list-group">
        @foreach (var slot in slots)
        {
            <form method="post" action="/ConsultationBooking/RequestBooking" class="list-group-item d-flex gap-2 align-items-center">
                @Html.AntiForgeryToken()
                <input type="hidden" name="lawyerId" value="@ViewBag.SelectedLawyerId" />
                <input type="hidden" name="start" value="@slot.ToString("O")" />
                <span class="flex-grow-1">@slot.ToString("dddd, dd MMM yyyy HH:mm")</span>
                <input name="notes" maxlength="300" class="form-control" placeholder="Optional note" />
                <button class="btn btn-success">Request</button>
            </form>
        }
        @if (!slots.Any())
        {
            <div class="alert alert-info">No available slots on this day.</div>
        }
    </div>
}
