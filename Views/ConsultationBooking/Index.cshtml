@{ ViewData["Title"] = "Book a consultation"; var lawyers = ViewBag.Lawyers as IEnumerable<SimplexLawFirm.Models.ApplicationUser> ?? []; var slots = ViewBag.Slots as IEnumerable<DateTime> ?? []; var specialties = ViewBag.Specialties as Dictionary<int,string> ?? []; }
<h1>Book a consultation</h1><p>Weekdays 09:00–16:00, 60 minutes. Fee: R 1,500.00. A lawyer must approve your booking before it is billable.</p>
<form method="get" class="row g-2 mb-4"><div class="col-md-5"><select class="form-select" name="lawyerId" required><option value="">Choose a lawyer and area of law</option>@foreach(var lawyer in lawyers){<option value="@lawyer.Id" selected="@(ViewBag.SelectedLawyerId == lawyer.Id)">@lawyer.FullName - @(specialties.GetValueOrDefault(lawyer.Id, "General practice"))</option>}</select></div><div class="col-md-3"><input class="form-control" type="date" name="date" value="@(((DateTime)ViewBag.SelectedDate).ToString("yyyy-MM-dd"))" /></div><div class="col-md-2"><button class="btn btn-primary">Show available times</button></div></form>
@if(ViewBag.SelectedLawyerId is not null){<div class="list-group">@foreach(var slot in slots){<form method="post" action="/ConsultationBooking/RequestBooking" class="list-group-item d-flex gap-2 align-items-center">@Html.AntiForgeryToken()<input type="hidden" name="lawyerId" value="@ViewBag.SelectedLawyerId"/><input type="hidden" name="start" value="@slot.ToString("O")"/><span class="flex-grow-1">@slot.ToString("dddd, dd MMM yyyy HH:mm")</span><input name="notes" maxlength="300" class="form-control" placeholder="Optional note"/><button class="btn btn-success">Request</button></form>}@if(!slots.Any()){<div class="alert alert-info">No available slots on this day.</div>}</div>}
