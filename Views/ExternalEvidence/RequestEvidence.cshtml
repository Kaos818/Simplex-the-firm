@model SimplexLawFirm.Models.Case
<h1>Request opposing-party documentation</h1><p>Send a single-use secure upload link for <b>@Model.CaseNumber</b>. Issuing a new request revokes the prior unused link.</p><form asp-action="RequestEvidence" method="post" class="surface stack-form">@Html.AntiForgeryToken()<input type="hidden" name="caseId" value="@Model.Id"/><label>Recipient name<input name="recipientName" required maxlength="150"/></label><label>Recipient email<input name="recipientEmail" type="email" required maxlength="254"/></label><button class="btn-primary-modern">Send secure documentation request</button></form>
