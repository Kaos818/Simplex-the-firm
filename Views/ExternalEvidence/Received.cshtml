@model IReadOnlyList<SimplexLawFirm.Models.ExternalEvidenceRequest>
@{ Layout = "_Layout"; var matter = (SimplexLawFirm.Models.Case)ViewBag.Case; }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><h1>Opposing-party documents</h1><p class="text-muted">@matter.CaseNumber - secure request and submission history</p></div><a asp-action="RequestEvidence" asp-route-caseId="@matter.Id" class="btn btn-primary">Send new one-time link</a></div>@foreach(var request in Model){<div class="card border-0 shadow-sm mb-3"><div class="card-body"><div class="d-flex justify-content-between"><div><h5>@request.RecipientName</h5><p class="text-muted">@request.RecipientEmail - requested @request.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p></div><span class="badge @(request.ClosedAtUtc.HasValue?"bg-success":request.RevokedAtUtc.HasValue?"bg-secondary":request.AccessedAtUtc.HasValue?"bg-warning text-dark":"bg-primary") align-self-start">@(request.ClosedAtUtc.HasValue?"Submitted":request.RevokedAtUtc.HasValue?"Revoked":request.AccessedAtUtc.HasValue?"Opened":"Awaiting access")</span></div>@foreach(var document in request.Documents){<div class="border rounded p-3 mb-2"><div class="d-flex justify-content-between"><div><b>@document.OriginalFileName</b><p class="mb-0">@document.Purpose</p><small class="text-muted">SHA-256 @document.Sha256Hash</small></div><a asp-action="Download" asp-route-id="@document.Id" class="btn btn-outline-primary btn-sm align-self-start">Download</a></div></div>}</div></div>}</div>
