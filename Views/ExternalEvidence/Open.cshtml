@model SimplexLawFirm.Models.ExternalEvidenceRequest
@{ Layout = null; var requirements=ViewBag.Requirements as IReadOnlyList<SimplexLawFirm.Models.CaseDocumentRequirement> ?? []; }
<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css"/><title>Secure documentation portal</title><style>body{background:linear-gradient(135deg,#eaf4f2,#f8fafc);min-height:100vh}.shell{max-width:820px;margin:auto}.hero{background:#0b2b37;color:#fff;border-radius:20px 20px 0 0}.card{border:0;border-radius:20px}.document-row{background:#f5f8f8;border:1px solid #dce8e6;border-radius:14px}.btn-submit{background:#0f766e;color:white}</style></head><body><main class="shell py-5 px-3"><section class="hero p-4"><small class="text-uppercase">One-time secure portal</small><h1>Share case documentation</h1><p class="mb-0">Matter @Model.Case.CaseNumber. This session expires after 20 minutes and closes permanently after submission or when you leave this page.</p></section><form id="evidenceForm" asp-action="Upload" method="post" enctype="multipart/form-data" class="card shadow p-4">@Html.AntiForgeryToken()<div id="documentRows"><div class="document-row p-3 mb-3"><label class="form-label fw-bold">Document</label><input class="form-control mb-3" type="file" name="files" accept=".pdf,.jpg,.jpeg,.png" required/><label class="form-label fw-bold">Document type</label><select name="requirementCodes" class="form-select mb-3"><option value="">Other supporting document</option>@foreach(var requirement in requirements){<option value="@requirement.Code">@requirement.Name (@requirement.Importance)</option>}</select><label class="form-label fw-bold">What does this document support?</label><textarea class="form-control" name="purposes" required maxlength="2500" rows="3"></textarea></div></div><button type="button" class="btn btn-outline-secondary mb-3" id="addDocument">Add another document</button><button class="btn btn-submit btn-lg">Submit documents and close portal</button><p class="text-muted small mt-3 mb-0">Accepts up to five PDF, JPEG, or PNG files, 10 MB each. Leaving without submitting permanently closes this session; a new link must be requested.</p></form></main><script>let submitting=false;const form=document.getElementById('evidenceForm');form.addEventListener('submit',()=>submitting=true);document.getElementById('addDocument').addEventListener('click',()=>{const host=document.getElementById('documentRows');if(host.children.length>=5)return;host.append(host.firstElementChild.cloneNode(true));});addEventListener('pagehide',()=>{if(submitting)return;const data=new FormData();data.append('__RequestVerificationToken',form.querySelector('[name=__RequestVerificationToken]').value);fetch('/ExternalEvidence/Abandon',{method:'POST',body:data,keepalive:true});});</script></body></html>
